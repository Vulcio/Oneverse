{
  "name": "songverse",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run --filter \"./packages/*\" build && vp run -r --parallel --no-cache dev",
    "lint": "vp run -r lint",
    "type-check": "vp run --filter \"./packages/*\" build && vp run -r type-check",
    "test": "vp run --filter \"./packages/*\" build && vp run -r test",
    "db:migrate": "pnpm --filter @songverse/db exec prisma migrate dev",
    "db:generate": "pnpm --filter @songverse/db exec prisma generate",
    "db:seed": "pnpm --filter @songverse/db exec prisma db seed",
    "clean": "vp cache clean && rm -rf node_modules",
    "e2e": "pnpm --filter @songverse/e2e e2e"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  }
}

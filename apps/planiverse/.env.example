# The NestJS API's public URL (signing in included), read at runtime -
# see packages/app/src/public-env.ts. The API needs PLANIVERSE_URL set to
# this app's address to trust it.
API_URL="http://localhost:3001"
# Songverse's address: a date's set opens there. Unset, sets aren't shown.
SONGVERSE_URL="http://localhost:3000"

PORT=3002

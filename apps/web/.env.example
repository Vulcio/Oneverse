# The NestJS API's public URL - also where BetterAuth itself lives now
# (apps/api/src/auth/), so this is the only backend this app talks to. A
# normal runtime env var — see packages/app/src/public-env.ts for why it's not done
# via Vite's build-time VITE_-prefixed env inlining.
API_URL="http://localhost:3001"

PORT=3000

---
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400-italic.css";
import { Image } from "astro:assets";
import "../styles/site.css";
import stage from "../assets/stage.webp";
import { DOCS_URL, ONEVERSE_URL, PLANIVERSE_URL, SCREEN_URL, SONGVERSE_URL, type Text } from "../i18n";
import Logo from "./Logo.astro";

interface Props {
  t: Text;
}
const { t } = Astro.props;
const docs = t.lang === "fr" ? `${DOCS_URL}/fr/` : `${DOCS_URL}/`;
// Where each app opens; Slideverse has none yet. Screen opens on its
// operator's console, as Oneverse's home does.
const appUrls: Record<string, string | undefined> = { plan: PLANIVERSE_URL, screen: `${SCREEN_URL}/operate` };
const appIcons: Record<string, string> = {
  // A calendar.
  plan: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  // A note.
  songverse: '<circle cx="7" cy="18" r="3"/><circle cx="17" cy="16" r="3"/><path d="M10 18V5l10-2v13"/>',
  // A screen.
  screen: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  // Slides, one over the other.
  slideverse: '<rect x="6" y="3" width="15" height="11" rx="2"/><path d="M3 8v9a2 2 0 0 0 2 2h12"/>',
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={new URL("/stage.jpg", Astro.site)} />
    <meta name="theme-color" content="#0b0b0f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={new URL("/", Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL("/fr/", Astro.site)} />
  </head>
  <body>
    <div class="hero">
      <header class="wrap top">
        <a href={t.lang === "fr" ? "/fr/" : "/"} aria-label="Oneverse"><Logo /></a>
        <nav>
          <a href={docs}>{t.docs}</a>
          <a href={t.otherLanguage.href} lang={t.lang === "fr" ? "en" : "fr"}>{t.otherLanguage.label}</a>
          <a class="button small" href={ONEVERSE_URL}>{t.signIn}</a>
        </nav>
      </header>
      <section class="wrap hero-body">
        <div class="hero-text">
          <h1>{t.heroTitle[0]}<br /><em>{t.heroTitle[1]}</em></h1>
          <p class="lead">{t.heroText}</p>
          <p class="actions">
            <a class="button" href={ONEVERSE_URL}>{t.openOneverse} <span aria-hidden="true">→</span></a>
            <a class="button ghost" href={docs}>{t.readDocs}</a>
          </p>
          <ul class="hero-points">
            {t.heroPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        {/* Oneverse and its apps, drawn as orbits around one centre. */}
        <svg class="orbits" viewBox="0 0 600 600" aria-hidden="true">
          <circle cx="300" cy="300" r="110" />
          <circle cx="300" cy="300" r="190" />
          <circle cx="300" cy="300" r="270" />
          <circle class="core" cx="300" cy="300" r="16" />
          <g class="planet"><circle cx="410" cy="300" r="7" /><text x="424" y="305">Songverse</text></g>
          <g class="planet"><circle cx="166" cy="166" r="7" /><text x="180" y="171">Plan</text></g>
          <g class="planet"><circle cx="300" cy="490" r="7" /><text x="314" y="495">Screen</text></g>
          <g class="planet later"><circle cx="491" cy="491" r="6" /><text x="505" y="496">Slideverse</text></g>
        </svg>
      </section>
    </div>

    <main>
      <section class="songverse" id="songverse">
        <Image class="songverse-photo" src={stage} alt={t.songverseAlt} widths={[800, 1280, 1672]} sizes="100vw" />
        <div class="wrap songverse-text">
          <p class="eyebrow">Songverse · {t.musicians}</p>
          <h2>{t.songverseTitle[0]}<br /><em>{t.songverseTitle[1]}</em></h2>
          <p class="section-lead">{t.songverseText}</p>
          <ul class="points">
            {t.songversePoints.map((point) => (
              <li>
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </li>
            ))}
          </ul>
          <p class="actions"><a class="button" href={SONGVERSE_URL}>{t.openSongverse} <span aria-hidden="true">→</span></a></p>
        </div>
      </section>

      <section class="wrap around" id="apps">
        <h2>{t.aroundTitle[0]} <em>{t.aroundTitle[1]}</em></h2>
        <p class="section-lead">{t.aroundText}</p>
        <ul class="app-cards">
          {t.apps.map((app) => {
            const href = appUrls[app.key];
            return (
              <li class:list={["app-card", { later: !href }]}>
                <span class="app-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={appIcons[app.key]} />
                </span>
                <p class="app-name">{app.name}{!href && <span class="badge">{t.later}</span>}</p>
                <h3>{app.title}</h3>
                <p>{app.text}</p>
                {href && <p class="card-action"><a href={href}>{app.open} <span aria-hidden="true">→</span></a></p>}
              </li>
            );
          })}
        </ul>
      </section>

      <section class="wrap closing">
        <h2>{t.forWhoTitle}</h2>
        <p>{t.forWhoText}</p>
        <p class="cta"><em>{t.ctaTitle}</em></p>
        <p class="actions center">
          <a class="button" href={ONEVERSE_URL}>{t.openOneverse} <span aria-hidden="true">→</span></a>
        </p>
      </section>
    </main>

    <footer class="wrap bottom">
      <Logo />
      <nav>
        <a href={ONEVERSE_URL}>Oneverse</a>
        <a href={SONGVERSE_URL}>Songverse</a>
        <a href={PLANIVERSE_URL}>Oneverse Plan</a>
        <a href={`${SCREEN_URL}/operate`}>Screen</a>
        <a href={docs}>{t.footerDocs}</a>
        <a href={t.otherLanguage.href} lang={t.lang === "fr" ? "en" : "fr"}>{t.otherLanguage.label}</a>
      </nav>
      <small>© {new Date().getFullYear()} Oneverse</small>
    </footer>
  </body>
</html>

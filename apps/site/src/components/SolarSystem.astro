---
// Oneverse and its apps as a small solar system, seen from the side: the
// apps orbit a glowing centre, pass in front of it and behind it, and the
// whole system tilts and drifts as the page scrolls. Drawn by the script
// below from these bodies; still when someone asks for less motion.
const bodies = [
  { key: "songverse", orbit: 0.3, size: 0.075, angle: 0.4, speed: 0.05 },
  { key: "plan", orbit: 0.5, size: 0.06, angle: 2.6, speed: 0.032 },
  { key: "screen", orbit: 0.7, size: 0.05, angle: 4.4, speed: 0.022 },
  { key: "slideverse", orbit: 0.9, size: 0.036, angle: 1.4, speed: 0.015 },
];
---

<div class="system" aria-hidden="true" data-solar-system>
  <div class="plane">
    <svg class="rings" preserveAspectRatio="none">
      {bodies.map(() => <ellipse />)}
    </svg>
    <span class="body sun"></span>
    {bodies.map((b) => (
      <span class={`body planet is-${b.key}`} data-orbit={b.orbit} data-size={b.size} data-angle={b.angle} data-speed={b.speed}></span>
    ))}
  </div>
</div>

<script>
  for (const system of document.querySelectorAll<HTMLElement>("[data-solar-system]")) {
    const plane = system.querySelector<HTMLElement>(".plane")!;
    const sun = system.querySelector<HTMLElement>(".sun")!;
    const rings = [...system.querySelectorAll<SVGEllipseElement>("ellipse")];
    const planets = [...system.querySelectorAll<HTMLElement>(".planet")].map((el) => ({
      el,
      orbit: Number(el.dataset.orbit),
      size: Number(el.dataset.size),
      angle: Number(el.dataset.angle),
      speed: Number(el.dataset.speed),
    }));
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let width = 0;
    let height = 0;
    const measure = () => {
      width = system.clientWidth;
      height = system.clientHeight;
    };
    measure();
    new ResizeObserver(measure).observe(system);

    const start = performance.now();
    const draw = (now: number) => {
      // How far the hero has scrolled away, 0 to 1.
      const scrolled = Math.min(1, Math.max(0, scrollY / Math.max(1, system.offsetHeight)));
      const time = still.matches ? 0 : (now - start) / 1000;
      // Seen nearly edge-on, opening up a little as the page scrolls.
      const flat = 0.2 + 0.16 * scrolled;
      const reach = Math.min(width * 0.5, height * 1.1);
      const cx = width / 2;
      const cy = height / 2;
      plane.style.transform = `translateY(${scrolled * height * 0.18}px) rotate(${-12 + 8 * scrolled}deg) scale(${1 + 0.12 * scrolled})`;

      const sunSize = reach * 0.3;
      sun.style.cssText = `width:${sunSize}px;height:${sunSize}px;left:${cx - sunSize / 2}px;top:${cy - sunSize / 2}px;z-index:100`;

      planets.forEach((planet, i) => {
        const r = planet.orbit * reach;
        const ring = rings[i];
        ring.setAttribute("cx", String(cx));
        ring.setAttribute("cy", String(cy));
        ring.setAttribute("rx", String(r));
        ring.setAttribute("ry", String(r * flat));
        const angle = planet.angle + time * planet.speed + scrolled * 1.4 * planet.speed * 20;
        const depth = Math.sin(angle); // 1 in front of the sun, -1 behind it
        const size = planet.size * reach * 2 * (1 + 0.28 * depth);
        const x = cx + Math.cos(angle) * r;
        const y = cy + depth * r * flat;
        planet.el.style.cssText = `width:${size}px;height:${size}px;left:${x - size / 2}px;top:${y - size / 2}px;z-index:${100 + Math.round(depth * 50)};opacity:${0.72 + 0.28 * (depth + 1) / 2}`;
      });
      if (!still.matches) requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
    // With motion off, it's drawn again only when the page scrolls.
    addEventListener("scroll", () => still.matches && requestAnimationFrame(draw), { passive: true });
  }
</script>

<style>
  .system { position: absolute; inset: 0 -8% 0 38%; z-index: 0; pointer-events: none; }
  .plane { position: absolute; inset: 0; transform-origin: 50% 50%; }
  .rings { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .rings ellipse { fill: none; stroke: rgba(244, 241, 234, 0.09); stroke-width: 1; }
  .body { position: absolute; border-radius: 50%; }
  /* Light from the upper left, the night side dark. */
  .sun {
    background: radial-gradient(circle at 38% 34%, #fff6e0 0%, #f6c177 34%, #c9782f 78%, #7a3f14 100%);
    box-shadow: 0 0 60px 10px rgba(246, 193, 119, 0.35), 0 0 160px 40px rgba(246, 193, 119, 0.14);
  }
  .planet { box-shadow: inset -0.35em -0.45em 0.9em rgba(0, 0, 0, 0.65); font-size: 1rem; }
  .is-songverse { background: radial-gradient(circle at 32% 28%, #c7c2ff 0%, #6d5ef5 38%, #2b2170 100%); }
  .is-plan { background: radial-gradient(circle at 32% 28%, #b5f5e8 0%, #20a99a 40%, #0b4a44 100%); }
  .is-screen { background: radial-gradient(circle at 32% 28%, #ffd9b8 0%, #ef7d3a 40%, #6e2b0c 100%); }
  .is-slideverse { background: radial-gradient(circle at 32% 28%, #6b6a72 0%, #34333b 50%, #16151b 100%); opacity: 0.6; }

  @media (max-width: 960px) {
    .system { inset: 0 -30% 0 10%; opacity: 0.4; }
  }
  @media (max-width: 640px) {
    /* On a phone the system gets its own space above the words. */
    .system { position: relative; inset: auto; height: 15rem; margin: 0 -1rem 0; opacity: 1; }
  }
</style>

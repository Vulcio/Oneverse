---
// A placeholder until the real logo is ready: the app's note icon in a
// rounded square, and the name.
---
<span class="logo">
  <span class="mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="18" r="4" /><path d="M12 18V2l7 4" /></svg>
  </span>
  <span class="name">Oneverse</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 600; letter-spacing: -0.01em; font-size: 1.05rem; }
  .mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 0.6rem; background: var(--fg); color: var(--bg); }
</style>

# The screen app (issue #305), at screen.oneverse.top. See Deploy.md.
# The API's address.
API_URL=http://localhost:3001
# Songverse's address: where a screen is paired (its Screens page, from the QR code).
SONGVERSE_URL=http://localhost:3000
# Oneverse's address: where people sign in.
ONEVERSE_URL=http://localhost:3003
# The screen app's own address: its console (/operate) signs in through Oneverse
# as the OAuth client "screen", sent back here. Also set on the API.
SCREEN_URL=http://localhost:3004

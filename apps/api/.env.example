PORT=3001

# Shared with packages/db — same Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/songverse_dev?schema=public"

# BetterAuth is mounted here (apps/api/src/auth/, see main.ts) - it used to
# live in apps/web, but moved here so every client (the web app today, a
# future mobile app tomorrow) authenticates against the same backend
# instead of the web app's own server. AUTH_URL is this API's own public
# URL (BetterAuth's baseURL/issuer, and where its session cookie/JWKS
# live). WEB_URL is the *browser-facing* app's public URL - needed
# separately because a WebAuthn passkey is tied to the origin the browser
# was actually on when registering it (the web app), not to wherever the
# auth server lives, and because verification/reset-password links
# redirect back into the web app, which - being a different origin from
# AUTH_URL - has to be explicitly trusted (see trustedOrigins in
# better-auth.ts). Also used for CORS: the web app calls this API's
# /api/auth/* endpoints cross-origin, with credentials (cookies), so CORS
# must name its exact origin (see main.ts) rather than a wildcard.
AUTH_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
# Planiverse's address (issue #241), when it's deployed: trusted like WEB_URL, and where
# notifications about groups that only plan, and organisations' events, link to.
# PLANIVERSE_URL="http://localhost:3002"
# Oneverse's address (issue #303, docs/sign-in-with-oneverse.md), when it's deployed:
# where people sign in. Songverse and Planiverse then sign in through it, as OAuth
# clients, and may be on domains of their own.
# ONEVERSE_URL="http://localhost:3003"
BETTER_AUTH_SECRET="replace-with: npx -y @better-auth/cli secret"

# Comma-separated emails auto-promoted to global admin on sign-up. There's
# no other bootstrap path, so this is the only way in.
BOOTSTRAP_ADMIN_EMAILS="you@example.com"

# Only invited people can create an account (issue #198). Admin > Users
# overrides it; the bootstrap admins above can always sign up.
# SIGNUP_INVITE_ONLY="true"

# Notifications by email (issue #236), off by default: Admin > Notifications
# overrides it. They go through the Resend key above, with its sending limits.
# NOTIFICATION_EMAILS="true"

# Organisations (issue #241; Admin > Organisations wins): NONE (default), SINGLE or MULTI,
# and with MULTI whether anyone may create one.
# ORGANIZATION_MODE="NONE"
# ORGANIZATIONS_OPEN="false"

# Push notifications (web push, issue #236): a VAPID key pair, or generate one
# at Admin > Notifications. npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

REDIS_URL="redis://localhost:6379"
# Background jobs run in the Worker (src/worker.ts). The API runs them too
# when this is true - by default outside production, so `pnpm dev` works
# without a Worker. In production, leave it unset and run a Worker.
# JOBS_IN_API="true"

# Sent as part of the User-Agent on every MusicBrainz API request, as their
# rate-limiting policy requires (an email or URL identifying this
# deployment) - see https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_CONTACT="https://songverse.one"

# Cloudflare R2 (S3-compatible) - fallback path only. The preferred way to
# set this up is now the admin dashboard (Admin > Storage), which stores
# credentials in the database instead - see SETTINGS_ENCRYPTION_KEY below.
# These are only used when nothing has been saved there.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="songverse"
R2_ENDPOINT=""

# Resend (https://resend.com) - sends the account-verification and
# password-reset emails (see src/auth/email.ts). Fallback path only -
# prefer Admin > Auth once the app is up, which takes effect immediately
# with no redeploy. Leave unset (here and in the database) to log those
# emails to stdout instead of sending them - fine for local dev, not fine
# in production. Only these two transactional emails are ever sent, never
# bulk/marketing mail, to stay comfortably inside the free tier's
# daily/monthly send cap.
RESEND_API_KEY=""
EMAIL_FROM="Songverse <onboarding@resend.dev>"

# Google sign-in (optional) - also configurable through Admin > Auth
# instead of these env vars. Leave both unset (here and in the database) to
# disable it entirely - the "Continue with Google" button only appears once
# either path is configured. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with authorized
# redirect URI "<AUTH_URL>/api/auth/callback/google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Any long random string. Required to save secrets (R2, Resend, Google)
# through the admin dashboard (encrypts them at rest in the database) -
# leave unset if you're managing all of the above purely via env vars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=""

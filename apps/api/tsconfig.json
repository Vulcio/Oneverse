{
  "extends": "@oneverse/tsconfig/nestjs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    // This is a runnable application, never imported as a library by
    // anything else - declaration output serves no purpose. It would also
    // have to name every type in better-auth's inferred config, some of
    // which come from packages pnpm keeps out of this app's reach
    // (@simplewebauthn/server, better-auth's own zod), so it can't build.
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}

# Each app keeps its own .env.example with the exact set it reads - copy
# those into place for local development: apps/api/.env.example,
# apps/web/.env.example, apps/planiverse/.env.example and
# packages/db/.env.example. Postgres and Redis
# come from `docker compose up -d`. The ones most often needed:

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/songverse_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# The API's own address (BetterAuth lives there), and the web app's.
AUTH_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
# Planiverse's (issue #241), when it runs too: the API trusts it.
# PLANIVERSE_URL="http://localhost:3002"
BETTER_AUTH_SECRET=""
# The web app reads the API's address at runtime (not a VITE_ variable).
API_URL="http://localhost:3001"

# The user documentation (apps/docs, docs.songverse.one): a static Astro /
# Starlight site, built here and served by nginx. No runtime configuration.
#
# Like Dockerfile.api and Dockerfile.songverse, it lives at the repo root and is
# built with the root as context, since the install needs the workspace's
# lockfile.
FROM node:22-slim AS build
# Pinned for the same reason as Dockerfile.songverse.
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /repo
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY patches ./patches
COPY apps/docs/package.json apps/docs/
RUN pnpm install --frozen-lockfile --filter @songverse/docs
COPY apps/docs apps/docs
RUN pnpm --filter @songverse/docs build

FROM nginx:1.27-alpine
COPY apps/docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/docs/dist /usr/share/nginx/html
EXPOSE 80

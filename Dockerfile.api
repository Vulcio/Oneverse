# Builds the NestJS API and BullMQ worker from the same image — only the
# CMD entrypoint differs at deploy time (api runs `node dist/main.js`,
# worker overrides it to `node dist/worker.js`).
#
# Lives at the repo root, not apps/api/, on purpose: it needs to COPY
# sibling packages (packages/core, packages/db, packages/secret-crypto), so
# it must be built with the repo root as the Docker build context. Some PaaS UIs (Dokploy
# included) default the build context to "the directory the Dockerfile is
# in" regardless of a separately configured context path — keeping the
# Dockerfile at the root sidesteps that entirely.
FROM node:22-slim AS base
# node:22-slim doesn't ship OpenSSL, which Prisma's query engine needs to
# detect at runtime to pick the right binary — without it Prisma falls
# back to a guess ("Defaulting to openssl-1.1.x") that happens to work by
# luck on some hosts and may not on others.
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
# Pin pnpm explicitly rather than letting corepack lazily resolve a version
# from package.json at first use — some base-image corepack versions treat
# an unhashed "packageManager" pin as advisory and silently fetch latest
# instead, which broke a monorepo build here (pnpm 10 -> 12 changed
# workspace resolution behavior).
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY patches ./patches
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/secret-crypto/package.json packages/secret-crypto/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/tsconfig packages/tsconfig
COPY packages/core packages/core
COPY packages/db packages/db
COPY packages/secret-crypto packages/secret-crypto
COPY apps/api apps/api
RUN pnpm --filter @oneverse/core build \
 && pnpm --filter @oneverse/db build \
 && pnpm --filter @oneverse/secret-crypto build \
 && pnpm --filter @oneverse/api build

FROM base AS runtime
ENV NODE_ENV=production
# ffmpeg (and its ffprobe): the Worker turns recorded takes into Opus with it (issue #127), and uploads above 320 kbps (#182).
# Only the runtime image needs it; without it, takes stay as recorded (WAV).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
# pg_dump and pg_restore for the backups (issue #119), from PostgreSQL's own
# packages: Debian's are another major version than the server's, and pg_dump
# refuses a server newer than itself. POSTGRES_CLIENT is the server's major.
ARG POSTGRES_CLIENT=16
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-common ca-certificates \
 && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
 && apt-get install -y --no-install-recommends postgresql-client-${POSTGRES_CLIENT} \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /repo/node_modules /repo/node_modules
COPY --from=build /repo/packages /repo/packages
COPY --from=build /repo/apps/api /repo/apps/api
# The workspace's package.json holds the version being prepared (issue #164).
COPY --from=build /repo/package.json /repo/package.json
# A release's image is told its version and commit (.github/workflows/release.yml);
# any other build reports the package.json's as "-dev".
ARG ONEVERSE_VERSION=
ARG ONEVERSE_COMMIT=
ENV ONEVERSE_VERSION=${ONEVERSE_VERSION} ONEVERSE_COMMIT=${ONEVERSE_COMMIT}
WORKDIR /repo/apps/api
EXPOSE 3001
# Applies pending Prisma migrations before the API starts, so a deploy never
# runs new code against an old schema. Safe when several instances start at
# once (Prisma takes a database lock), and a failed migration keeps the new
# version from starting. The Worker's command override (`node
# dist/worker.js`) replaces this line, so only the API migrates. `exec` makes
# node PID 1 so it receives the container's stop signal.
CMD ["sh", "-c", "/repo/packages/db/node_modules/.bin/prisma migrate deploy --schema /repo/packages/db/prisma/schema.prisma && exec node dist/main.js"]

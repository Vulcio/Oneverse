{
  "name": "@oneverse/db",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "prisma": {
    "seed": "tsx seeds/seed.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "vp lint src seeds --deny-warnings",
    "type-check": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@oneverse/core": "workspace:*",
    "@oneverse/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-plus": "1.0.0"
  }
}

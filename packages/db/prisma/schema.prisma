// ============================================================
// Songverse — Prisma Schema
// ============================================================
// Conventions:
//   - All IDs use cuid() for global uniqueness
//   - createdAt / updatedAt on every table
//   - JSON fields typed as Json (Prisma) — validate at app layer
//   - Enums use SCREAMING_SNAKE_CASE
//   - Relation fields use camelCase
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum SongIdentifierType {
  CCLI // Worship-specific. Numeric string.
  ISWC // ISO composition ID. Format: T-000.000.000-C. Belongs on Work.
  ISRC // Recording ID. Format: CC-XXX-YY-NNNNN. Belongs on audio attachments.
  MUSICBRAINZ_WORK // MusicBrainz Work UUID. Belongs on Work.
  MUSICBRAINZ_RECORDING // MusicBrainz Recording UUID. Belongs on Song Version.
  SPOTIFY // Spotify track ID. Belongs on Song Version (a specific recording).
  APPLE_MUSIC // Apple Music track ID. Belongs on Song Version.
  DEEZER // Deezer track ID. Belongs on Song Version.
  YOUTUBE // YouTube video ID. Belongs on Song Version.
  CUSTOM // Internal catalog numbers or platform-specific IDs.
  METADATA_MATCH // The song info chosen in Auto detect (issue #22): details holds the match, value its first source.
}

enum ImportFormat {
  CHORDPRO
  CHORDS_OVER_LYRICS // Ultimate Guitar style — chords on line above lyrics
  RAW_TEXT // Plain lyrics, no chords
  LRC // Timestamped lyrics [MM:SS.ms]
  MUSICXML
  ABC_NOTATION
}

enum InstrumentType {
  GUITAR_STANDARD // 6-string E A D G B E
  GUITAR_ALTERNATE // Any non-standard guitar tuning
  BASS_STANDARD // 4-string E A D G
  UKULELE_STANDARD // 4-string G C E A (soprano/concert/tenor)
  PIANO // Keyboard diagram — note-based, no fret positions
}

enum VoicingPreference {
  OPEN // Prefer open chord voicings
  BARRE // Prefer barre chord shapes
  DROP2 // Drop 2 voicings (jazz)
  CLOSE // Close position voicings (piano)
  AUTO // Let Songverse decide based on key and context
}

enum CapoDisplayMode {
  SOUNDING
  FINGERED
}

enum ChordNotation {
  LETTERS
  SOLFEGE
  // Nashville numbers, in the key of each pass (issue #207).
  NASHVILLE
  // Roman numerals, in the key of each pass (issue #220).
  ROMAN
}

// Chord diagrams beside a chart (issue #207): none, or for this instrument.
enum ChordDiagrams {
  OFF
  GUITAR
  UKULELE
  PIANO
}

// How a song reads in Live (issue #155): see LIVE_VIEWS in packages/core.
enum LiveView {
  CHART
  GRID
  PDF
}

enum MidiEventType {
  PROGRAM_CHANGE
  CONTROL_CHANGE
}

enum TagScope {
  GLOBAL // Admin-curated, available to all users
  USER // Created by a user, private to them
  TEAM // Created by a team, visible to team members
}

enum OwnershipScope {
  GLOBAL
  TEAM
  USER
}

enum SongbookKind {
  // An unordered collection - entries have no number.
  SIMPLE
  // Entries are numbered to match a printed edition; numbers are unique
  // within the songbook.
  NUMBERED
}

enum PublicationState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
  ARCHIVED
}

enum VersionRelationshipType {
  ORIGINAL
  DIRECT_TRANSLATION
  SINGABLE_ADAPTATION
  LYRICAL_ADAPTATION
  ALTERNATE_VERSION
  SIMPLIFIED_VERSION
  LIVE_VERSION
  UNKNOWN_ORIGIN
}

enum ContributorRole {
  AUTHOR
  COMPOSER
  LYRICIST
  TRANSLATOR
  ADAPTOR
  ARRANGER
  PERFORMER
}

enum TeamRole {
  MEMBER
  ADMIN
}

enum SubmissionState {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ProposalState {
  OPEN
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  PARTIALLY_APPLIED
  WITHDRAWN
}

enum ProposalType {
  TYPO_FIX
  LYRIC_FIX
  CHORD_CORRECTION
  METADATA_UPDATE
  STRUCTURE_UPDATE
  TRANSLATION_LINK
  FULL_REVISION
}

enum AttachmentType {
  PDF
  CHORDPRO
  MUSICXML
  ABC_NOTATION
  TEXT
  IMAGE
  AUDIO
  OTHER
}

// Which part of the song an AUDIO attachment is (issue #64), for the stem
// player; null for a full mix. The order the player lists them in is
// STEM_PARTS in @oneverse/core.
enum StemPart {
  VOCALS
  // Sung harmonies (issue #131), from the top.
  HARMONY_SOPRANO
  HARMONY_ALTO
  HARMONY_TENOR
  HARMONY_BASS
  BACKING_VOCALS
  DRUMS
  BASS
  GUITAR
  KEYS
  OTHER
  CLICK
}

enum DisplayMode {
  SINGER
  GUITAR
  PIANO
  UKULELE
  LEADER
  DRUMMER
}

enum NotePlace {
  ME
  TEAM
  SONGBOOK
  SET
  SONG
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  PROMOTED_TO_GLOBAL
  ARRANGEMENT_FROZEN
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED
}

// ============================================================
// USERS
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  displayName   String
  avatarUrl     String?
  // Required by the BetterAuth Prisma adapter. Mapped from BetterAuth's
  // "emailVerified" field; displayName/avatarUrl are mapped from BetterAuth's
  // "name"/"image" via the adapter's field-mapping config (see apps/web auth.ts)
  // rather than renaming these columns.
  emailVerified Boolean  @default(false)
  isGlobalAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Moderation (Admin > Users). A banned user can't sign in; their content
  // is untouched.
  bannedAt         DateTime?
  banReason        String?
  // Set when an admin deletes the account but keeps its content behind a
  // transfer link (see ContentTransfer): the row stays, unusable, until the
  // content is claimed or the link expires, then it's removed for real.
  deletedAt        DateTime?
  // Storage key of an avatar uploaded through the account page. Null when
  // there's none, or when avatarUrl points elsewhere (e.g. Google's).
  avatarStorageKey String?

  // What they do on a team: keys from INSTRUMENTS / TECH_ROLES in
  // packages/core, validated by the API.
  instruments String[] @default([])
  techRoles   String[] @default([])

  // Preferences
  locale            String            @default("en") // UI language - see SUPPORTED_LOCALES in packages/core
  displayMode       DisplayMode       @default(GUITAR)
  capoDisplayMode   CapoDisplayMode   @default(SOUNDING)
  // Chord names in letters (G) or solfège (Sol) on every chart.
  chordNotation     ChordNotation     @default(LETTERS)
  // How songs read in Live unless chosen for a song (issue #155).
  liveView          LiveView          @default(CHART)
  // Chord diagrams on charts (issue #207): off unless chosen.
  chordDiagrams     ChordDiagrams     @default(OFF)
  // Chords coloured by family - major, minor, sus, dim, aug, dominant (issues #9, #207).
  chordColors       Boolean           @default(false)
  // Diagrams mirrored for a left-handed player, and each instrument's tuning (issue #207 phase 3): TUNINGS' ids in core.
  leftHanded        Boolean           @default(false)
  // The first day of calendars' weeks (issue #235): 0 Sunday, 1 Monday, 6 Saturday; null from the language.
  weekStartsOn      Int?
  guitarTuning      String            @default("standard")
  ukuleleTuning     String            @default("standard")
  // Piano diagrams (issue #207 phase 4): smooth voice leading or root position, both hands or the right only, note names on the keys ("card", "all", "none").
  pianoSmooth       Boolean           @default(true)
  pianoHands        String            @default("both")
  pianoNoteNames    String            @default("card")
  /// What the Display panel changed for each mode (issue #209): { EDIT, PRACTICE, LIVE } each a partial
  /// DisplaySettings (@oneverse/core), over the account settings above.
  displaySettings   Json              @default("{}")
  voicingPreference VoicingPreference @default(AUTO)
  pedalMappingJson  Json? // UserPedalMapping — null = use defaults
  midiOutputDevice  String? // Last selected MIDI output device name

  // Relations
  teamMemberships           TeamMembership[]
  organizationMemberships   OrganizationMembership[]
  hostedOrganizationEvents  OrganizationEvent[]      @relation("OrganizationEventHost")
  createdOrganizationEvents OrganizationEvent[]      @relation("OrganizationEventCreatedBy")
  ownedVersions             SongVersion[]            @relation("VersionOwnerUser")
  contributorCredits        VersionContributor[]
  ownedArrangements         Arrangement[]            @relation("ArrangementOwnerUser")
  chartPreferences          ChartPreference[]
  chordShapeChoices         ChordShapeChoice[]
  submissions               Submission[]
  reviewedSubmissions       Submission[]             @relation("SubmissionReviewer")
  proposals                 ChangeProposal[]
  notes                     Note[]
  noteReplies               NoteReply[]              @relation("NoteReplyAuthor")
  auditEvents               AuditEvent[]
  accessGrants              AccessGrant[]
  shareLinks                ShareLink[]
  inkAnnotations            InkAnnotation[]
  midiConfigs               UserArrangementMidi[]
  ownedTags                 Tag[]
  stemSeparations           StemSeparation[]
  roleAssignments           RoleAssignment[]
  // Their own screens (issue #186), and those they put a set on (issue #222).
  screens                   Screen[]
  screensSet                Screen[]                 @relation("ScreenSetBy")
  // Their own screen themes (issue #194).
  screenThemes              ScreenTheme[]
  screenParts               ScreenPart[]
  // The people they invited to sign up (issue #198).
  signupInvitations         SignupInvitation[]
  ownedSongbooks            Songbook[]               @relation("SongbookOwnerUser")
  songbookShares            SongbookShare[]          @relation("SongbookShareUser")
  songbooksShared           SongbookShare[]          @relation("SongbookShareBy")
  importJobs                ImportJob[]
  uploadedAttachments       Attachment[]             @relation("AttachmentUploader")
  ownedSetlists             Setlist[]                @relation("SetlistOwnerUser")
  guestSetlists             SetlistGuest[]
  sharedSetlistItems        SetlistItem[]            @relation("SetlistItemSharedBy")
  ownershipRequests         SongOwnershipRequest[]
  contentTransfer           ContentTransfer?
  offlinePins               OfflinePin[]

  // BetterAuth
  sessions             Session[]
  accounts             Account[]
  passkeys             Passkey[]
  // Sign in with Oneverse (issue #303): the apps' tokens and consents.
  oauthClients         OauthClient[]
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]
  oauthConsents        OauthConsent[]
  smartLists           SmartList[]
  songRevisions        SongVersionRevision[]
  contributedVersions  SongVersion[]         @relation("VersionContributedBy")
  songsSharedWithMe    AccessGrant[]         @relation("AccessGrantTo")
  favoriteSongs        FavoriteSong[]
  songViews            SongView[]
  connectionsAsked     Connection[]          @relation("ConnectionRequester")
  connectionsAnswered  Connection[]          @relation("ConnectionAddressee")
  reviewedProposals    ChangeProposal[]      @relation("ProposalReviewer")
  teamEventsCreated    TeamEvent[]           @relation("TeamEventCreatedBy")
  eventAnswers         TeamEventAnswer[]     @relation("TeamEventAnswerUser")
  eventAnswersGiven    TeamEventAnswer[]     @relation("TeamEventAnswerBy")
  awayRanges           UserAway[]
  calendarFeed         CalendarFeed?
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  answerRequestsMade   TeamAnswerRequest[]   @relation("AnswerRequestsMade")
  assignments          TeamEventAssignment[] @relation("Assignments")
  assignmentsMade      TeamEventAssignment[] @relation("AssignmentsMade")
  // How each kind of notification reaches them (issue #236): push, email; quiet hours.
  notificationSettings Json?
  screenWidgetDefaults ScreenWidgetDefault[]

  @@index([email])
}

// ============================================================
// AUTH (BetterAuth Prisma adapter tables)
// ============================================================
// Session/Account/Verification are BetterAuth's own tables, required by its
// Prisma adapter. They are not part of the Songverse domain model.

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  @@index([identifier])
}

// Required by BetterAuth's passkey plugin (apps/web auth.ts) - one row per
// registered WebAuthn credential, so a user can have several (e.g. laptop +
// phone).
model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
}

// Signing keys for BetterAuth's JWT plugin (apps/web auth.ts), which the
// NestJS API verifies tokens against via JWKS.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?
}

// Sign in with Oneverse (issue #303, docs/sign-in-with-oneverse.md): the API
// is an OAuth 2.1 / OpenID Connect provider (@better-auth/oauth-provider),
// Songverse and Planiverse its clients. These are the plugin's tables, under
// the names its Prisma adapter looks for (oauthClient -> OauthClient).
model OauthClient {
  id                               String    @id @default(cuid())
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json?
  clientCredentialsScopes          Json?
  // Our own clients (Songverse, Planiverse) have no user.
  userId                           String?
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime? @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           Json?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json?
  responseTypes                    Json?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         String?

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
}

model OauthResource {
  id                            String    @id @default(cuid())
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime? @updatedAt
  policyVersion                 Int?      @default(1)
  metadata                      String?

  clients OauthClientResource[]
}

model OauthClientResource {
  id         String    @id @default(cuid())
  clientId   String
  resourceId String
  metadata   String?
  createdAt  DateTime? @default(now())

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
}

model OauthRefreshToken {
  id                      String    @id @default(cuid())
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  expiresAt               DateTime?
  createdAt               DateTime? @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
}

model OauthAccessToken {
  id                      String    @id @default(cuid())
  token                   String?   @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  refreshId               String?
  expiresAt               DateTime?
  createdAt               DateTime? @default(now())
  revoked                 DateTime?
  confirmation            String?
  scopes                  String[]

  client  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([refreshId])
}

model OauthConsent {
  id                      String    @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  String[]
  createdAt               DateTime? @default(now())
  updatedAt               DateTime? @updatedAt

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model OauthClientAssertion {
  id        String   @id @default(cuid())
  expiresAt DateTime
}

// ============================================================
// TEAMS
// ============================================================

model Team {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  // Its picture (issue #161): served by the API at avatarUrl, the stored
  // object at avatarStorageKey; and its colour, a key of ENTITY_COLORS in
  // @oneverse/core (null: one derived from the name).
  avatarUrl        String?
  avatarStorageKey String?
  color            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  memberships          TeamMembership[]
  inviteLinks          TeamInviteLink[]
  ownedVersions        SongVersion[]          @relation("VersionOwnerTeam")
  ownedArrangements    Arrangement[]          @relation("ArrangementOwnerTeam")
  notes                Note[]
  accessGrants         AccessGrant[]
  shareLinks           ShareLink[]
  ownedTags            Tag[]
  ownedSongbooks       Songbook[]             @relation("SongbookOwnerTeam")
  songbookShares       SongbookShare[]        @relation("SongbookShareTeam")
  ownedSetlists        Setlist[]              @relation("SetlistOwnerTeam")
  ownershipRequests    SongOwnershipRequest[]
  visibleAttachments   Attachment[]           @relation("AttachmentVisibleToTeam")
  contributedVersions  SongVersion[]          @relation("VersionContributedByTeam")
  // What its members may do (issue #160), and its storage pool's limit.
  roleAssignments      RoleAssignment[]
  // Its screens' looks (issue #194), for every member to pick.
  screenThemes         ScreenTheme[]
  screenParts          ScreenPart[]
  // Its screens (issue #222), which outlive whoever paired them.
  screens              Screen[]
  // Its calendar (issue #235), and how many weeks ahead each date's set is made (1-52).
  events               TeamEvent[]
  calendarFeed         CalendarFeed?
  answerRequests       TeamAnswerRequest[]
  setsAheadWeeks       Int                    @default(4)
  // The organisation it's part of (issue #241), or none: a team of its own,
  // as in Songverse alone. Its members are the organisation's members too.
  organizationId       String?
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // A group of an organisation (issue #241): whether it's a Songverse team -
  // songs, songbooks, sets - or only plans (a welcome team, a cleaning rota);
  // the group it's under, in the same organisation; the positions of its own
  // its members cover ("Greeter", "Coffee"), besides instruments and roles.
  usesSongverse        Boolean                @default(true)
  parentId             String?
  parent               Team?                  @relation("Subgroups", fields: [parentId], references: [id], onDelete: SetNull)
  subgroups            Team[]                 @relation("Subgroups")
  positions            TeamPosition[]
  screenWidgetDefaults ScreenWidgetDefault[]
  brands               Brand[]
  // Its own Songverse Sonic server for its songs' stems (issue #300).
  sonicServer          SonicServer?

  @@index([slug])
  @@index([organizationId])
  @@index([parentId])
}

// A position of a group's own (issue #241): "Greeter", "Coffee", "Hall".
model TeamPosition {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, name])
}

// An organisation (issue #241, Planiverse): a church, a club... whose teams
// it plans together. An instance has none (Songverse alone), one, or
// several (Admin > Organisations, OrganizationSettings).
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  // A key of ENTITY_COLORS in @oneverse/core (null: one derived from the name).
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  OrganizationMembership[]
  inviteLinks  OrganizationInviteLink[]
  teams        Team[]
  events       OrganizationEvent[]
  eventPresets OrganizationEventPreset[]
  // Its screens (issue #222): the church's projector, its stage monitor.
  screens      Screen[]
  // Its brands (issue #279): logos, colours, fonts, backgrounds, links.
  brands       Brand[]
  // Its own Songverse Sonic server for its teams' songs' stems (issue #300).
  sonicServer  SonicServer?
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           TeamRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInviteLink {
  id             String    @id @default(cuid())
  organizationId String
  token          String    @unique @default(cuid())
  role           TeamRole  @default(MEMBER)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  usedCount      Int       @default(0)
  maxUses        Int?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Whether the instance has organisations (issue #241), set in Admin >
// Organisations: each field null takes its env var, then the default.
model OrganizationSettings {
  id            String   @id @default("singleton")
  // NONE (Songverse alone), SINGLE (one, everyone in it) or MULTI (ORGANIZATION_MODE).
  mode          String?
  // With several: anyone may create one, not only global admins (ORGANIZATIONS_OPEN).
  anyoneCreates Boolean?
  updatedAt     DateTime @updatedAt
}

model TeamMembership {
  id          String   @id @default(cuid())
  teamId      String
  userId      String
  role        TeamRole @default(MEMBER)
  // The group's own positions they cover (TeamPosition ids, issue #241).
  positionIds String[] @default([])
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInviteLink {
  id        String    @id @default(cuid())
  teamId    String
  token     String    @unique @default(cuid())
  role      TeamRole  @default(MEMBER)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  usedCount Int       @default(0)
  maxUses   Int? // null = unlimited

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([teamId])
}

// ============================================================
// WORKS
// ============================================================

model Work {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The preferred original version (optional)
  preferredOriginalVersionId String?      @unique
  preferredOriginalVersion   SongVersion? @relation("WorkPreferredOriginal", fields: [preferredOriginalVersionId], references: [id])

  // Relations
  versions    SongVersion[]    @relation("WorkVersions")
  workTags    WorkTag[]
  identifiers WorkIdentifier[]
}

// ============================================================
// WORK-LEVEL IDENTIFIERS
// ============================================================

// WorkIdentifier stores composition-level IDs (ISWC, MusicBrainz Work ID).
// These belong on Work, not Song Version, because they identify
// the abstract composition across all versions.
model WorkIdentifier {
  id         String             @id @default(cuid())
  workId     String
  type       SongIdentifierType
  value      String
  sourceUrl  String? // e.g. https://musicbrainz.org/work/uuid
  verifiedAt DateTime? // Set when confirmed against external source
  note       String?
  // What the identifier points at (a MusicBrainz title, artist, album...)
  // as of verifiedAt, so showing it needs no lookup.
  details    Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, type]) // one ISWC, one MBID per Work
  @@index([workId])
  @@index([type, value])
}

// ============================================================
// TAG TAXONOMY
// ============================================================

// TagCategory defines the type of tag: "theme", "style", "season", etc.
// Global categories are admin-curated. Admins can add new category types.
model TagCategory {
  id           String   @id @default(cuid())
  slug         String   @unique // e.g. "theme", "style", "season"
  label        String // e.g. "Theme", "Musical Style", "Liturgical Season" - English fallback
  // Per-locale overrides, e.g. {"fr": "Thème"}. A locale missing here falls
  // back to `label`. Keyed by the app's locale codes (see SUPPORTED_LOCALES
  // in packages/core), not full BCP 47 - these are UI display labels, not
  // the song-content `language` field elsewhere in the schema.
  translations Json?
  description  String?
  sortOrder    Int      @default(0)
  isGlobal     Boolean  @default(true) // false = user/team-defined category
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags Tag[]

  @@index([slug])
}

// Tag is a single value within a category.
// Global tags are admin-curated. Users and teams can create their own.
model Tag {
  id           String   @id @default(cuid())
  categoryId   String
  slug         String   @unique // e.g. "easter", "jazz", "advent"
  label        String // e.g. "Easter", "Jazz", "Advent" - English fallback
  // Per-locale overrides, e.g. {"fr": "Pâques"}. Same convention as
  // TagCategory.translations. Only meaningful for admin-curated GLOBAL
  // tags - a user/team's own custom tag is just their freeform text.
  translations Json?
  description  String?
  scope        TagScope @default(GLOBAL)
  ownerUserId  String? // set when scope = USER
  ownerTeamId  String? // set when scope = TEAM
  isApproved   Boolean  @default(false) // user-suggested tags start false; admin approves
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category    TagCategory      @relation(fields: [categoryId], references: [id])
  ownerUser   User?            @relation(fields: [ownerUserId], references: [id])
  ownerTeam   Team?            @relation(fields: [ownerTeamId], references: [id])
  workTags    WorkTag[]
  versionTags SongVersionTag[]

  @@index([categoryId])
  @@index([scope])
  @@index([ownerUserId])
  @@index([ownerTeamId])
}

// WorkTag: tags applied at the Work level.
// All versions of a Work inherit these tags by default.
model WorkTag {
  id        String   @id @default(cuid())
  workId    String
  tagId     String
  createdAt DateTime @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([workId, tagId])
  @@index([workId])
  @@index([tagId])
}

// SongVersionTag: tags applied at the Song Version level.
// A version may inherit Work-level tags (resolved at app layer) and
// add or remove its own tags independently.
model SongVersionTag {
  id            String   @id @default(cuid())
  songVersionId String
  tagId         String
  // inherited = true means this tag was propagated from the Work.
  // Users can remove inherited tags per-version by deleting this record.
  inherited     Boolean  @default(false)
  createdAt     DateTime @default(now())

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([songVersionId, tagId])
  @@index([songVersionId])
  @@index([tagId])
}

// ============================================================
// SONG VERSIONS
// ============================================================

model SongVersion {
  id        String   @id @default(cuid())
  workId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership
  ownerScope  OwnershipScope @default(USER)
  ownerUserId String?
  ownerTeamId String?

  // Publication
  publicationState    PublicationState @default(DRAFT)
  // Who put it in the global catalogue (issue #73): the person whose song
  // it was, or who submitted it for their team (contributedByTeamId). The
  // song itself moves to the catalogue, so this is how they're credited.
  contributedByUserId String?
  contributedByTeamId String?

  // Core metadata
  title           String
  alternateTitle  String? // shown as "Subtitle"
  // Tells this version apart from the song's others: "Acoustic", "Youth band".
  versionName     String?
  sortTitle       String? // how to sort it, if not by title
  language        String // BCP 47 tag: en, fr, de, etc.
  trustLabel      String? // Free text: "Official publisher text", etc.
  // Its image (issue #85): the album or single's artwork, kept on our
  // storage (content-addressed, like attachments), and where it came from.
  imageStorageKey String?
  imageSourceUrl  String?

  // Rights metadata
  copyright     String?
  copyrightYear Int?
  publisher     String? // Free text

  // More facts about the song, each its own field (see the song page's
  // Details, and docs/songbook-catalog-format.md for what a catalogue
  // entry fills in). Key, tempo, time signature and duration live in
  // documentJson.defaults instead, next to the chart they describe.
  album     String?
  year      Int? // written or published; separate from copyrightYear
  isrc      String? // recording code, compact: USRC17607839
  reference String? // e.g. the scripture a song draws on
  notes     String?

  // The song's CCLI number: this column is its only record (no
  // SongIdentifier row is kept for it), indexed for exact lookups.
  ccli String?

  // What library search matches, "contains" and ignoring case: the title,
  // subtitle, version name and performers' names in one column, so a
  // trigram index can serve it, without accents (issue #56). Maintained by
  // database triggers on SongVersion and VersionContributor (migrations
  // 20260929090000, 20261003110000) - never written by the app.
  searchText String @default("")

  // The sung lines, folded as a lyrics search compares them, one per line
  // (issue #221, lyricsSearchText in @oneverse/core): written by the API
  // with each save of the chart; null until worked out (the Worker's
  // lyrics backfill fills older songs).
  lyricsText String?

  // Canonical content
  // SongDocument v2 (docs/song-document-v2.md): the music only. Rows saved
  // before v2 are upgraded by the API on read and at startup.
  documentJson Json
  // Capo fret the song is played with. It belongs to arrangements; it stays
  // here until arrangements exist, then seeds each song's default one.
  capo         Int?

  // Version relationship (relationship to parent/source)
  relationshipType VersionRelationshipType?
  parentVersionId  String?

  // Work relation
  work              Work          @relation("WorkVersions", fields: [workId], references: [id])
  ownerUser         User?         @relation("VersionOwnerUser", fields: [ownerUserId], references: [id])
  ownerTeam         Team?         @relation("VersionOwnerTeam", fields: [ownerTeamId], references: [id])
  contributedBy     User?         @relation("VersionContributedBy", fields: [contributedByUserId], references: [id], onDelete: SetNull)
  contributedByTeam Team?         @relation("VersionContributedByTeam", fields: [contributedByTeamId], references: [id], onDelete: SetNull)
  parentVersion     SongVersion?  @relation("VersionChildren", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions     SongVersion[] @relation("VersionChildren")

  // Preferred original back-relation
  preferredOriginalFor Work? @relation("WorkPreferredOriginal")

  // Groove default for the whole song version (section-level overrides live in documentJson)
  defaultGrooveStyleId String?
  defaultGrooveVariant String?

  // Related records
  contributors      VersionContributor[]
  attachments       Attachment[]
  stemSeparations   StemSeparation[]
  arrangements      Arrangement[]
  chartPreferences  ChartPreference[]
  chordShapeChoices ChordShapeChoice[]
  progression       SongProgression?
  songbookEntries   SongbookEntry[]
  versionTags       SongVersionTag[]
  identifiers       SongVersionIdentifier[]
  submissions       Submission[]            @relation("SubmissionSong")
  publishedFrom     Submission[]            @relation("SubmissionPublished")
  importJobs        ImportJob[]
  proposals         ChangeProposal[]
  upstreamLinks     UpstreamLink[]          @relation("UpstreamLinkLocal")
  downstreamLinks   UpstreamLink[]          @relation("UpstreamLinkGlobal")
  accessGrants      AccessGrant[]
  shareLinks        ShareLink[]
  auditEvents       AuditEvent[]
  setlistItems      SetlistItem[]
  ownershipRequests SongOwnershipRequest[]
  userNotes         Note[] // notes on it (issue #256); not the song's `notes` field
  revisions         SongVersionRevision[]
  favoritedBy       FavoriteSong[]
  views             SongView[]

  @@index([workId])
  @@index([ownerUserId])
  @@index([ownerTeamId])
  @@index([ownerScope, publicationState])
  @@index([language])
  @@index([ccli])
  // Trigram (pg_trgm) indexes for "contains"/"ignoring case" searches.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lyricsText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([alternateTitle(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ============================================================
// CONTRIBUTORS
// ============================================================

// userId is nullable so a contributor can be recorded from `source` alone
// (e.g. an artist name pulled from MusicBrainz) without requiring them to
// be a registered Songverse user — the app layer enforces that at least
// one of userId/source is set.
model VersionContributor {
  id             String            @id @default(cuid())
  songVersionId  String
  userId         String?
  roles          ContributorRole[]
  source         String? // Optional free text: "Hillsong Music", etc.
  // `source` without accents, for the credit autocomplete (issue #56).
  // Maintained by a database trigger (migration 20261003110000) - never
  // written by the app.
  sourceSearch   String?
  // True only for the contributor row a MusicBrainz recording link
  // creates automatically. Lets re-linking (or unlinking) replace just
  // that row without touching one a user added by hand — both are
  // source-only (userId null), so they're otherwise indistinguishable.
  isAutoAttached Boolean           @default(false)
  displayOrder   Int               @default(0)
  createdAt      DateTime          @default(now())

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@unique([songVersionId, userId])
  @@index([songVersionId])
  @@index([userId])
  // Credit autocomplete ("contains", ignoring case and accents).
  @@index([source(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sourceSearch(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ============================================================
// SONG VERSION IDENTIFIERS
// ============================================================

// SongVersionIdentifier stores version-level IDs (CCLI, ISRC, MusicBrainz
// Recording ID, Custom). CCLI is also denormalized on SongVersion for fast queries.
model SongVersionIdentifier {
  id            String             @id @default(cuid())
  songVersionId String
  type          SongIdentifierType
  value         String
  sourceUrl     String? // e.g. https://musicbrainz.org/recording/uuid
  verifiedAt    DateTime? // Set when confirmed against external source
  note          String? // e.g. "Based on 2019 Hillsong live recording"
  // What the identifier points at (a MusicBrainz title, artist, album...)
  // as of verifiedAt, so showing it needs no lookup.
  details       Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)

  @@unique([songVersionId, type]) // one CCLI, one MBID recording per version
  @@index([songVersionId])
  @@index([type, value])
}

// ============================================================
// ARRANGEMENTS
// ============================================================

model Arrangement {
  id            String   @id @default(cuid())
  songVersionId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Ownership: a user or a team, like songs, whoever owns the song itself
  // (arranging a song you can't edit is the main use).
  ownerScope  OwnershipScope @default(USER)
  ownerUserId String?
  ownerTeamId String?

  name        String
  description String?

  // ArrangementDocument v2 (docs/arrangement-document-v2.md): how it's
  // played - order, key, capo, tempo, per-pass overrides - pointing at the
  // song's sections, lines and chords by ID. `songRevision` in it is the
  // song revision it was last checked against.
  documentJson Json

  // The team's usual arrangement of this song, picked when the song is
  // added to one of the team's sets. At most one per team and song (kept
  // by the API).
  isTeamDefault Boolean @default(false)

  // Set only when it's one song's arrangement for one set (reordering,
  // skipping or repeating sections just there): not listed with the song's
  // arrangements, owned like its set, and gone with the set's song.
  setlistItemId String?      @unique
  setlistItem   SetlistItem? @relation("SetOnlyArrangement", fields: [setlistItemId], references: [id], onDelete: Cascade)

  // Guitar tuning for this arrangement (null = standard tuning)
  // Stored here as a convenience cache — authoritative value is in documentJson.defaults
  guitarTuningPresetId String?
  guitarTuningPreset   TuningPreset? @relation(fields: [guitarTuningPresetId], references: [id])

  // Relations: an arrangement can't outlive its song.
  songVersion      SongVersion           @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  ownerUser        User?                 @relation("ArrangementOwnerUser", fields: [ownerUserId], references: [id])
  ownerTeam        Team?                 @relation("ArrangementOwnerTeam", fields: [ownerTeamId], references: [id])
  setlistItems     SetlistItem[]         @relation("PlayedArrangement")
  midiConfigs      UserArrangementMidi[]
  grooveOverrides  ArrangementGroove[]
  chartPreferences ChartPreference[]

  @@index([songVersionId])
  @@index([ownerUserId])
  @@index([ownerTeamId])
  @@index([guitarTuningPresetId])
}

// A player's own view of one chart (docs/arrangement-document-v2.md,
// "Personal chart preferences"): chords they hide, simpler chords, no bass
// notes. Per user, and per arrangement - or per song when it's played as
// written. Never shared, never changes the song or the arrangement.
// A song's chord progressions (issue #204), for finding songs by progression:
// worked out from the chart (core's songProgressions) for the chart's
// revision, and worked out again when the chart has moved on. Never part of
// the song itself.
model SongProgression {
  songVersionId String   @id
  revision      Int
  // [{ sectionId, type, label, degrees: ["1", "5", "6m", "4"] }]
  sections      Json
  // Runs of 3 and 4 chords, "1-5-6m": what's searched and compared.
  grams         String[]
  updatedAt     DateTime @updatedAt

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)

  @@index([grams], type: Gin)
}

// The shape a player chose for a chord of a song (issue #207 phase 3): theirs
// only, for that song, on that instrument and tuning. `chord` is the chord as
// fretted ("G" with the capo on); `frets` the shape as players write it
// ("320003", shapeText in core).
model ChordShapeChoice {
  id            String   @id @default(cuid())
  userId        String
  songVersionId String
  instrument    String
  tuning        String   @default("standard")
  chord         String
  frets         String
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, songVersionId, instrument, tuning, chord])
  @@index([songVersionId])
}

model ChartPreference {
  id              String   @id @default(cuid())
  userId          String
  songVersionId   String
  arrangementId   String?
  // arrangementId, or "" for the song as written: one unique index covers both.
  arrangementKey  String   @default("")
  // chart-preferences/v1
  preferencesJson Json
  updatedAt       DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  songVersion SongVersion  @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  arrangement Arrangement? @relation(fields: [arrangementId], references: [id], onDelete: Cascade)

  @@unique([userId, songVersionId, arrangementKey])
  @@index([songVersionId])
  @@index([arrangementId])
}

// ============================================================
// SETLISTS
// ============================================================

model Setlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional: an unnamed set is shown by its date (formatted in the
  // viewer's language), or as an untitled set when it has no date either.
  name        String?
  description String?
  eventDate   DateTime? @db.Date

  // Owned by exactly one user or one team; deleted along with its owner.
  ownerUserId String?
  ownerTeamId String?

  ownerUser         User?                  @relation("SetlistOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam         Team?                  @relation("SetlistOwnerTeam", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  items             SetlistItem[]
  notes             Note[]
  shareLink         SetlistShareLink?
  guests            SetlistGuest[]
  ownershipRequests SongOwnershipRequest[]
  // Multitracks recorded for this set (issue #127).
  multitrackFiles   Attachment[]           @relation("AttachmentMultitrackSetlist")
  // The screens showing it (issue #186).
  screens           Screen[]
  // The date of a team's event it was made for (issue #235).
  eventDateOf       TeamEventDate?

  @@index([ownerUserId])
  @@index([ownerTeamId])
}

// A team's event (issue #235): a one-off, or every n weeks on its first
// date's weekday until a date or for ever. Its time is a wall-clock time in
// its time zone (the same across daylight saving); its dates are worked out
// by eventDates() in @oneverse/core. Managed by the team's admins.
model TeamEvent {
  id                  String    @id @default(cuid())
  teamId              String
  title               String
  // Its first date, and its start ("HH:MM") in timeZone.
  date                DateTime  @db.Date
  startTime           String
  durationMinutes     Int       @default(90)
  // Its call time (issue #240): minutes before the start to be there.
  callMinutes         Int?
  timeZone            String
  place               String?
  note                String?
  // Null: a one-off.
  repeatEveryWeeks    Int?
  repeatUntil         DateTime? @db.Date
  // The parts it needs (issue #235, phase 7): [{ part, name, count }] - an
  // instrument or role key (or custom instrument ID), or a name of its own.
  parts               Json?
  // A rehearsal tied to another of the team's events (issue #235, phase 7):
  // its dates are that event's, daysBefore days earlier, at its own time;
  // it has no set of its own (it uses the date's), and goes with the event.
  rehearsalForId      String?
  daysBefore          Int?
  // A group's part of an organisation's event (issue #241): its timing is
  // that event's, set there; the group's admins only choose its parts.
  organizationEventId String?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  team              Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy         User?                 @relation("TeamEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  dates             TeamEventDate[]
  answers           TeamEventAnswer[]
  reminders         TeamEventReminder[]
  lineup            TeamEventAssignment[]
  rehearsalFor      TeamEvent?            @relation("Rehearsals", fields: [rehearsalForId], references: [id], onDelete: Cascade)
  rehearsals        TeamEvent[]           @relation("Rehearsals")
  organizationEvent OrganizationEvent?    @relation(fields: [organizationEventId], references: [id], onDelete: Cascade)

  @@unique([organizationEventId, teamId])
  @@index([teamId])
}

// An organisation's event (issue #241, Planiverse): its host, its timing,
// and the groups it needs - each its own TeamEvent, with the parts it asks
// that group for, filled by the group's admins.
model OrganizationEvent {
  id               String    @id @default(cuid())
  organizationId   String
  title            String
  date             DateTime  @db.Date
  startTime        String
  durationMinutes  Int       @default(90)
  timeZone         String
  place            String?
  note             String?
  repeatEveryWeeks Int?
  repeatUntil      DateTime? @db.Date
  // Who's in charge of it.
  hostUserId       String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host         User?        @relation("OrganizationEventHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("OrganizationEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  teamEvents   TeamEvent[]

  @@index([organizationId])
}

// A saved list of what an organisation's event needs (issue #241):
// "Sunday service: Music (drums, bass), Welcome (Greeter x2)", with its usual timing.
model OrganizationEventPreset {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  title           String
  startTime       String
  durationMinutes Int      @default(90)
  place           String?
  // [{ teamId, parts }]
  needs           Json
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

enum AvailabilityAnswer {
  AVAILABLE
  IF_NEEDED
  UNAVAILABLE
}

// Someone's answer for a date of an event (issue #235): Available, If
// needed or Not available, with a note seen by them and the team's admins.
// answeredBy is an admin who answered for them (null: they did).
model TeamEventAnswer {
  id               String             @id @default(cuid())
  eventId          String
  date             DateTime           @db.Date
  userId           String
  answer           AvailabilityAnswer
  note             String?
  answeredByUserId String?
  updatedAt        DateTime           @updatedAt

  event      TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User      @relation("TeamEventAnswerUser", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User?     @relation("TeamEventAnswerBy", fields: [answeredByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, date, userId])
  @@index([userId])
}

// Someone's calendar link (issue #235): an iCalendar feed of the dates
// they signed up for, opened without signing in by the token in its address.
// Resetting it makes a new token (the old address stops); turning it off
// deletes the row.
model CalendarFeed {
  id        String   @id @default(cuid())
  // Someone's own link, or a team's (issue #240): all its dates, no answers.
  userId    String?  @unique
  teamId    String?  @unique
  token     String   @unique
  // A team's link: the language of the admin who made it.
  locale    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// Something Songverse tells someone (issue #236): its kind and details,
// put into words in the reader's language when shown (notificationText in
// @oneverse/core), never stored as text; where it leads (url, in the web
// app); read or not. Sent by push and email too, as the person chooses.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  data      Json
  url       String?
  // Which web app it's about (issue #241): "planiverse" for a group that only
  // plans, or an organisation's event; null for Songverse. Its email links
  // there, and its push goes to that app's devices first.
  app       String?
  readAt    DateTime?
  // When it went by email (issue #236): sent, or looked at and not sent (the person's choice, email off).
  emailedAt DateTime?
  // When it went to their devices, or was looked at and not sent (no device, the person's choice, push not set up).
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Days someone is away (issue #235), across all their teams: every date in
// them reads Not available unless they answered that date themselves.
model UserAway {
  id        String   @id @default(cuid())
  userId    String
  from      DateTime @db.Date
  to        DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One date of an event with something of its own: changed (cancelled,
// another time or title) or given its set. A date without a row is just
// the event's. setCreatedAt says its set was made once: a set someone
// deleted isn't made again (a cancelled date's empty set is deleted with
// setCreatedAt cleared, so it comes back if the date does).
model TeamEventDate {
  id           String    @id @default(cuid())
  eventId      String
  date         DateTime  @db.Date
  cancelled    Boolean   @default(false)
  startTime    String?
  title        String?
  setlistId    String?   @unique
  setCreatedAt DateTime?
  // When an admin told the people signed up that its set is ready (issue #235).
  setReadyAt   DateTime?

  event   TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  setlist Setlist?  @relation(fields: [setlistId], references: [id], onDelete: SetNull)

  @@unique([eventId, date])
}

// Someone scheduled on a part for one date of an event (issue #235, phase
// 7): asked (PENDING), then ACCEPTED or DECLINED. `partKey` is the part's
// key in the event's parts (partKey in @oneverse/core). Once a date has a
// line-up, the people on it - not declining - are who signed up for it.
enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model TeamEventAssignment {
  id               String           @id @default(cuid())
  eventId          String
  date             DateTime         @db.Date
  partKey          String
  // Null for a guest without an account (guestName): there for reference, never told anything.
  userId           String?
  guestName        String?
  status           AssignmentStatus @default(PENDING)
  // Their note when answering ("I can do keys instead").
  note             String?
  assignedByUserId String?
  createdAt        DateTime         @default(now())
  respondedAt      DateTime?
  // They asked for a replacement (a swap): offered to those who play the part; the first to take it gets the place.
  swapRequestedAt  DateTime?
  swapNote         String?
  // Offered to everyone who plays the part (issue #240): until then, only
  // to those who answered If needed (swapWidensAt).
  swapWidenedAt    DateTime?

  event      TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User?     @relation("Assignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("AssignmentsMade", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, date, partKey, userId])
  @@index([userId, date])
}

// A reminder sent for one date of an event (issue #235), so it's sent once:
// DAY_BEFORE, to the people signed up for it.
model TeamEventReminder {
  id      String   @id @default(cuid())
  eventId String
  date    DateTime @db.Date
  kind    String
  sentAt  DateTime @default(now())

  event TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date, kind])
}

// A team admin asking members for their answers (issue #235): the dates
// from `from` to `to`, by `deadline` (a day in `timeZone`, the asker's).
// Members without an answer for some of them are told when it's made, and
// reminded the day before the deadline (remindedAt).
model TeamAnswerRequest {
  id              String    @id @default(cuid())
  teamId          String
  from            DateTime  @db.Date
  to              DateTime  @db.Date
  deadline        DateTime  @db.Date
  timeZone        String
  createdByUserId String?
  createdAt       DateTime  @default(now())
  remindedAt      DateTime?

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AnswerRequestsMade", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

// At most one per set. Anyone signed in who opens it joins the set as a
// read-only guest (SetlistGuest); resetting it issues a new token, turning
// it off deletes the row. Guests already in stay until removed.
model SetlistShareLink {
  id        String   @id @default(cuid())
  setlistId String   @unique
  token     String   @unique
  createdAt DateTime @default(now())

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
}

// Someone who joined a set through its share link: can open the set and
// every song in it, and keep private notes, but not change it.
model SetlistGuest {
  id        String   @id @default(cuid())
  setlistId String
  userId    String
  joinedAt  DateTime @default(now())

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([setlistId, userId])
  @@index([userId])
}

enum OwnershipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A team admin asking a song's owner to hand a song shared into one of the
// team's sets over to the team. Accepting moves the song to the team.
model SongOwnershipRequest {
  id                String                 @id @default(cuid())
  songVersionId     String
  teamId            String
  // Where it was asked from, for context; kept if the set goes.
  setlistId         String?
  requestedByUserId String?
  status            OwnershipRequestStatus @default(PENDING)
  createdAt         DateTime               @default(now())
  decidedAt         DateTime?

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  setlist     Setlist?    @relation(fields: [setlistId], references: [id], onDelete: SetNull)
  requestedBy User?       @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([songVersionId, status])
  @@index([teamId])
}

model SetlistItem {
  id            String          @id @default(cuid())
  setlistId     String
  /// What it is (issue #305): a song, or slides of text. Each kind has its own fields: a song's songVersionId, a text's text.
  kind          SetlistItemKind @default(SONG)
  /// A song's; null for any other kind.
  songVersionId String?
  /// A text's (issue #305): {title, body}, the body's paragraphs its slides. Null for any other kind.
  text          Json?
  arrangementId String?
  position      Int // Sort order (0-based)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Per-item overrides. Transposition is in semitones relative to the song
  // version's own key (same convention as Arrangement.transposeSteps), so it
  // works even when the song has no key recorded.
  transposeSteps   Int            @default(0)
  tempoOverride    Int?
  notes            String? // Quick inline note
  // What happens after it (issue #199): null, nothing said; and for a
  // TRANSITION, what's played into the next song.
  transition       SetTransition?
  transitionNote   String?
  /// Chords played into the next song (issue #10), as degrees of its key: "2m7", "57".
  transitionChords String[]       @default([])
  /// Its own timer (issue #269): {kind: "countdown"|"count-up", duration: seconds}, started on the screens' stage when Live comes to it.
  timer            Json?

  // Set on a song shared into the set by its owner - when a personal set
  // moves to a team, its owner's songs a team set couldn't otherwise hold.
  // Readable through the set for as long as this user can still see it.
  sharedByUserId String?

  setlist        Setlist      @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  songVersion    SongVersion? @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  arrangement    Arrangement? @relation("PlayedArrangement", fields: [arrangementId], references: [id], onDelete: SetNull)
  // Its own arrangement for this set, if one was made (see Arrangement.setlistItemId).
  setArrangement Arrangement? @relation("SetOnlyArrangement")
  sharedBy       User?        @relation("SetlistItemSharedBy", fields: [sharedByUserId], references: [id], onDelete: SetNull)

  @@index([setlistId, position])
}

// ============================================================
// SONGBOOKS
// ============================================================

model Songbook {
  id           String   @id @default(cuid())
  name         String
  abbreviation String?
  language     String?
  publisher    String?
  year         Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SIMPLE songbooks are an unordered collection (entries have no code);
  // NUMBERED songbooks require a unique per-songbook entryCode, matching a
  // printed edition's numbering.
  kind SongbookKind @default(NUMBERED)

  // Its picture and colour (issue #161), as a team's.
  avatarUrl        String?
  avatarStorageKey String?
  color            String?

  // For NUMBERED songbooks only: an ordered list of number ranges mapped to
  // a display label (e.g. [{label: "JEM1", start: 1, end: 371}, ...]), used
  // to group/filter entries by volume. Computed on read against an entry's
  // numeric entryCode - never persisted per-entry, so editing a range's
  // boundary takes effect everywhere immediately. See
  // docs/songbooks-and-catalog.md §4.
  sections Json?

  // Ownership - GLOBAL songbooks are an admin-curated catalog (published
  // hymnals) visible to everyone; TEAM/USER songbooks are private to their
  // owner, same pattern as SongVersion/Arrangement.
  ownerScope  OwnershipScope @default(GLOBAL)
  ownerUserId String?
  ownerTeamId String?

  ownerUser User? @relation("SongbookOwnerUser", fields: [ownerUserId], references: [id])
  ownerTeam Team? @relation("SongbookOwnerTeam", fields: [ownerTeamId], references: [id])

  // Set when this songbook was created via "import from catalog" - entries
  // are materialized lazily (see docs/songbooks-and-catalog.md §6), so a
  // catalog entry with no matching SongbookEntry yet is still "pending"
  // rather than missing. SetNull on delete: if the catalog itself is later
  // removed, already-imported songbooks keep their real content untouched,
  // they just stop offering more entries to materialize.
  sourceCatalogId String?
  sourceCatalog   SongbookCatalog? @relation(fields: [sourceCatalogId], references: [id], onDelete: SetNull)

  entries SongbookEntry[]
  // Who else sees it, or changes it too (issue #211).
  shares  SongbookShare[]
  notes   Note[]

  @@index([ownerUserId])
  @@index([ownerTeamId])
  @@index([ownerScope])
}

/// A songbook shared with a person or a team (issue #211): they see it, its
/// entries and the songs in it (read-only, while they're in it); with
/// `canEdit`, they change its entries and details too - not delete it or
/// share it on. A team's share is its members', present and future.
model SongbookShare {
  id         String   @id @default(cuid())
  songbookId String
  userId     String?
  teamId     String?
  canEdit    Boolean  @default(false)
  sharedById String?
  createdAt  DateTime @default(now())

  songbook Songbook @relation(fields: [songbookId], references: [id], onDelete: Cascade)
  user     User?    @relation("SongbookShareUser", fields: [userId], references: [id], onDelete: Cascade)
  team     Team?    @relation("SongbookShareTeam", fields: [teamId], references: [id], onDelete: Cascade)
  sharedBy User?    @relation("SongbookShareBy", fields: [sharedById], references: [id], onDelete: SetNull)

  @@unique([songbookId, userId])
  @@unique([songbookId, teamId])
  @@index([userId])
  @@index([teamId])
}

model SongbookEntry {
  id            String   @id @default(cuid())
  songVersionId String
  songbookId    String
  // e.g. "245", "A-17", "FR-092" - required and unique per songbook when
  // the songbook's kind is NUMBERED; null and ignored for SIMPLE songbooks.
  // Multiple SIMPLE entries with entryCode = null don't conflict - Postgres
  // treats NULLs as distinct in a unique index.
  entryCode     String?
  createdAt     DateTime @default(now())

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  songbook    Songbook    @relation(fields: [songbookId], references: [id], onDelete: Cascade)

  @@unique([songVersionId, songbookId])
  @@unique([songbookId, entryCode])
}

// ============================================================
// SONGBOOK CATALOG
// ============================================================
// A curated, admin-maintained directory of known published songbooks -
// bibliographic metadata only (Goodreads/Google Books style), never lyrics,
// chords, sheet music, or audio. Deliberately decoupled from Songbook/
// SongbookEntry: a catalog entry can exist with no working Songbook built
// from it yet. See docs/songbooks-and-catalog.md.

model SongbookCatalog {
  id            String   @id @default(cuid())
  name          String
  abbreviation  String?
  publisher     String?
  isbn          String?
  description   String?
  coverImageUrl String?
  officialUrl   String?
  language      String?
  // True once Songverse has secured rights to distribute this songbook's
  // actual content - reserved for a future import path that would populate
  // real content instead of blank stubs. Not used by anything yet.
  licensed      Boolean  @default(false)
  // The printed volumes' number ranges, as a songbook's sections (issue #55):
  // [{ label: "JEM1", start: 1, end: 371 }, ...]. Copied into a songbook
  // imported from the catalogue.
  sections      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries           SongbookCatalogEntry[]
  importedSongbooks Songbook[]

  @@index([name])
}

// One song of a published songbook: facts about it, never its content. The
// fields and the CSV/JSON file format are defined together in
// packages/core/src/songbook-catalog-format/ (and docs/songbook-catalog-format.md).
model SongbookCatalogEntry {
  id               String   @id @default(cuid())
  catalogId        String
  entryCode        String // e.g. "0245"
  title            String
  sortTitle        String?
  subtitle         String?
  // Another entry this one translates or adapts, as written: "JEM 245"
  // (catalogue abbreviation and number) or just a number in this catalogue.
  // Resolved to a link when read, so it links up once that entry exists.
  originalSong     String?
  originalLanguage String?
  artist           String?
  composer         String?
  lyricist         String?
  album            String?
  year             Int?
  key              String?
  timeSignature    String? // "4/4"
  tempo            Int?
  durationSeconds  Int?
  copyright        String?
  ccli             String?
  isrc             String? // compact: USRC17607839
  // e.g. the scripture a song draws on.
  reference        String?
  tags             String[] @default([])
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  catalog SongbookCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, entryCode])
  @@index([catalogId])
}

// ============================================================
// ATTACHMENTS
// ============================================================

model Attachment {
  id                     String               @id @default(cuid())
  songVersionId          String
  type                   AttachmentType
  filename               String
  mimeType               String
  storageKey             String // S3 object key
  sizeBytes              Int?
  stemPart               StemPart?
  // How many semitones above its multitrack it was recorded (issue #135):
  // a take sung while the player was transposed. The player shifts it by
  // its transposition minus this, so it fits with the rest.
  pitchOffset            Int?
  /// Where each section starts in the recording (issue #110): [{ at, sectionId }], the same on each file of a multitrack.
  cuePoints              Json?
  /// Kept as uploaded (issue #145): not deleted, replaced by another take, merged or cleaned up until its uploader unlocks it.
  locked                 Boolean              @default(false)
  /// How it came in (issue #175): uploaded, separated from a recording, or recorded in Songverse's recorder - a multitrack's stems apart from the recordings people made into it.
  origin                 AttachmentOrigin     @default(UPLOADED)
  /// Its recording details found by the separation server's analysis (issue #175), not yet confirmed or changed: "key", "tempo", "timeSignature", "firstBeat", "sections".
  detected               String[]             @default([])
  // Its own name for the part (issue #131): "Descant", "Acoustic guitar",
  // "Count-in" - shown instead of the part's.
  partName               String?
  // For audio: the recording's own key ("G", "Bbm", as written) and tempo
  // (BPM), when they aren't the song's - null means the song's (issue #65).
  recordingKey           String?
  recordingTempo         Float?
  // Where its first beat falls, in seconds from its start (issue #100):
  // what places the metronome against it. Null means at 0:00.
  recordingFirstBeat     Float?
  // Its beginning is played freely, off the grid (issue #178): the click
  // waits for the first beat, with a count-in before it, rather than
  // clicking from 0:00.
  recordingFreeIntro     Boolean              @default(false)
  // The recording's beats and the first beat of each of its bars, in
  // seconds from its start (issue #299), as the stem separation's analysis
  // found them: what the bars follow, rather than one tempo. Empty: none.
  recordingBeats         Float[]              @default([])
  recordingDownbeats     Float[]              @default([])
  // A lossless upload's original (issue #182), as FLAC, kept beside the Opus
  // copy in storageKey that's played: for downloading, and for separating
  // stems from. Its uploader had a role that keeps them.
  originalStorageKey     String?
  originalMimeType       String?
  originalSizeBytes      Int?
  // Its time signature ("4/4", "6/8"), when it isn't the song's (issue #123).
  recordingTimeSignature String?
  // The multitrack it's part of (issue #123): files recorded together,
  // sharing their key, tempo, time signature and first beat, played
  // together. Null: the song's original stems. A group id, not a table:
  // the files carry the multitrack's name and values between them, as
  // they already did its key and tempo.
  multitrackId           String?
  multitrackName         String?
  // The set its multitrack was recorded for (issue #127): on that set's
  // song page, it's the one the player picks. Kept on every file of the
  // multitrack, as its name is.
  multitrackSetlistId    String?
  // Another take of a part (issue #127): kept, not played; "Use this take"
  // swaps it with the one playing.
  otherTake              Boolean              @default(false)
  // A recorded take being turned into Opus by the Worker (issue #127):
  // PENDING until then, FAILED if it couldn't be (it stays as recorded).
  processing             TakeProcessing?
  // Who the upload counts against for storage limits. Null for files
  // uploaded before this was tracked into a team-owned song, or whose
  // uploader has since been deleted.
  uploadedByUserId       String?
  // Who sees it, besides its uploader (issue #72): each person's files on
  // a song are their own layer. Files uploaded through the app start
  // PRIVATE; the default here is for rows from before, and bulk uploads.
  visibility             AttachmentVisibility @default(SONG)
  // TEAM: the team that sees it (one its uploader belongs to).
  visibleToTeamId        String?
  createdAt              DateTime             @default(now())

  songVersion       SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  uploadedBy        User?       @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  visibleToTeam     Team?       @relation("AttachmentVisibleToTeam", fields: [visibleToTeamId], references: [id], onDelete: SetNull)
  multitrackSetlist Setlist?    @relation("AttachmentMultitrackSetlist", fields: [multitrackSetlistId], references: [id], onDelete: SetNull)

  @@index([songVersionId])
  @@index([uploadedByUserId])
}

enum AttachmentOrigin {
  UPLOADED
  SEPARATED
  RECORDED
}

enum TakeProcessing {
  PENDING
  FAILED
}

enum AttachmentVisibility {
  // Its uploader only.
  PRIVATE
  // Its uploader and the members of visibleToTeam.
  TEAM
  // Everyone who can see the song.
  SONG
  // Its uploader and the people the song is shared with (AccessGrant, #77, #79).
  SHARED
}

// ============================================================
// NOTES
// ============================================================

enum OfflinePinKind {
  SET
  SONG
  SONGBOOK
}

/// Something a user keeps on their devices to use offline (docs/offline.md,
/// issue #52): a set or song pinned "Available offline", or a songbook with
/// "Keep a local copy" on. Stored here, not on the device, so it follows
/// the user to a new one. `targetId` isn't a foreign key (it points into
/// one of three tables): a pin whose target is deleted or no longer
/// visible is skipped by POST /offline/sync, and goes when it's unpinned
/// or its user is deleted.
model OfflinePin {
  id           String         @id @default(cuid())
  userId       String
  kind         OfflinePinKind
  targetId     String
  /// Download the audio files too (never by default: they're large).
  includeAudio Boolean        @default(false)
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
}

// A note on a song (issues #104, #256): one person writes it, pins it
// somewhere in the song (`anchor`, a NoteAnchor from @oneverse/core, by the
// chart's IDs) and saves it in a place, which decides who sees it: ME (its
// author; with setlistId, only in that set), TEAM, SONGBOOK, SET, or SONG
// (everyone who sees the song, written by its editors).
model Note {
  id            String    @id @default(cuid())
  place         NotePlace
  content       String
  anchor        Json
  songVersionId String
  authorUserId  String
  teamId        String?
  songbookId    String?
  setlistId     String?
  // Resolved: off the chart, kept in its thread.
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author      User        @relation(fields: [authorUserId], references: [id])
  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  songbook    Songbook?   @relation(fields: [songbookId], references: [id], onDelete: Cascade)
  setlist     Setlist?    @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  replies     NoteReply[]

  @@index([songVersionId])
  @@index([authorUserId])
}

model NoteReply {
  id           String   @id @default(cuid())
  noteId       String
  authorUserId String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User @relation("NoteReplyAuthor", fields: [authorUserId], references: [id])

  @@index([noteId])
  @@index([authorUserId])
}

// ============================================================
// SUBMISSIONS
// ============================================================

model Submission {
  id            String          @id @default(cuid())
  songVersionId String
  submitterId   String
  state         SubmissionState @default(SUBMITTED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Submission content
  submitterMessage String?
  duplicateReason  String? // Required if submitting as new despite duplicate warning

  // Admin review
  reviewerId    String?
  reviewNotes   String?
  mergeTargetId String? // SongVersion ID if merging into existing

  // Similarity results snapshot (JSON array of similar song version IDs + scores)
  similarityResults Json?

  // The global song an approval produced: the copy it made, or the
  // existing song it was merged into (mergeTargetId).
  publishedVersionId String?
  reviewedAt         DateTime?

  songVersion      SongVersion  @relation("SubmissionSong", fields: [songVersionId], references: [id], onDelete: Cascade)
  submitter        User         @relation(fields: [submitterId], references: [id])
  reviewer         User?        @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  publishedVersion SongVersion? @relation("SubmissionPublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@index([songVersionId])
  @@index([submitterId])
  @@index([state])
}

// ============================================================
// CHANGE PROPOSALS (for global songs)
// ============================================================

model ChangeProposal {
  id            String        @id @default(cuid())
  songVersionId String
  proposerId    String
  state         ProposalState @default(OPEN)
  type          ProposalType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  title       String
  description String?

  // The proposed change as a JSON diff or patch
  proposedChange Json

  // Admin review
  reviewerId  String?
  reviewNotes String?
  reviewedAt  DateTime?

  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  proposer    User        @relation(fields: [proposerId], references: [id])
  reviewer    User?       @relation("ProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([songVersionId])
  @@index([proposerId])
  @@index([state])
}

// ============================================================
// UPSTREAM LINKS (fork/copy tracking)
// ============================================================

model UpstreamLink {
  id                 String    @id @default(cuid())
  localVersionId     String // The fork/copy
  globalVersionId    String // The upstream global original
  forkedAt           DateTime  @default(now())
  lastSyncedAt       DateTime?
  hasUpstreamChanges Boolean   @default(false)

  localVersion  SongVersion @relation("UpstreamLinkLocal", fields: [localVersionId], references: [id], onDelete: Cascade)
  globalVersion SongVersion @relation("UpstreamLinkGlobal", fields: [globalVersionId], references: [id], onDelete: Cascade)

  @@unique([localVersionId, globalVersionId])
  @@index([globalVersionId])
}

// ============================================================
// ACCESS GRANTS (explicit sharing)
// ============================================================

/// A song shared with one person (issue #77), by its owner (or an admin of
/// its team) - someone they're connected to (Connection). They see it in
/// their library; with `canEdit`, they change its chart, details and
/// credits too (not delete, publish, hand over or share it).
model AccessGrant {
  id            String    @id @default(cuid())
  songVersionId String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?

  // Granted by
  grantedByUserId String

  // Granted to (one of these)
  grantedToUserId String?
  grantedToTeamId String?

  // Permissions
  canView     Boolean @default(true)
  canDownload Boolean @default(false)
  canEdit     Boolean @default(false)

  songVersion   SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  grantedByUser User        @relation(fields: [grantedByUserId], references: [id])
  grantedToUser User?       @relation("AccessGrantTo", fields: [grantedToUserId], references: [id], onDelete: Cascade)
  grantedToTeam Team?       @relation(fields: [grantedToTeamId], references: [id], onDelete: Cascade)

  @@unique([songVersionId, grantedToUserId])
  @@index([songVersionId])
  @@index([grantedToTeamId])
  @@index([grantedToUserId])
}

// ============================================================
// SHARE LINKS (external sharing)
// ============================================================

model ShareLink {
  id              String    @id @default(cuid())
  songVersionId   String
  createdByUserId String
  token           String    @unique @default(cuid())
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  canDownload Boolean @default(false)
  viewCount   Int     @default(0)

  // Optional team context
  teamId String?

  songVersion   SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  createdByUser User        @relation(fields: [createdByUserId], references: [id])
  team          Team?       @relation(fields: [teamId], references: [id])

  @@index([token])
  @@index([songVersionId])
}

// ============================================================
// INK ANNOTATIONS (post-MVP, schema included for forward compat)
// ============================================================

model InkAnnotation {
  id            String   @id @default(cuid())
  userId        String
  songVersionId String?
  arrangementId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Semantic anchor
  anchorType String // "section" | "line" | "segment" | "chord" | "arrangement_item"
  anchorId   String // Stable ID of the anchored element

  // Normalized geometry (relative to anchor, device-independent)
  geometryJson Json // Array of stroke paths in normalized coordinates

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([songVersionId])
  @@index([arrangementId])
}

// ============================================================
// CHORD VOICINGS
// ============================================================

// TuningPreset — named guitar/bass tunings for quick selection.
// Standard tunings are seeded. Users can define custom tunings.
model TuningPreset {
  id         String         @id @default(cuid())
  instrument InstrumentType
  name       String // "DADGAD", "Drop D", "Open G", "Standard"
  slug       String         @unique // "dadgad", "drop_d", "open_g", "standard"
  notes      String[] // Open string notes low→high: ["D","A","D","G","A","D"]
  isStandard Boolean        @default(false) // true = ships with Songverse
  isDefault  Boolean        @default(false) // true = the default for that instrument
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  voicings     ChordVoicing[]
  arrangements Arrangement[]

  @@index([instrument])
  @@index([slug])
}

// ChordVoicing — a single playable chord shape for a given instrument and tuning.
//
// Sources:
//   "chords-db"  — seeded from tombatossals/chords-db (standard guitar + ukulele)
//   "generated"  — computed by the voicing generation algorithm (alternate tunings)
//   "manual"     — added or corrected by a Songverse admin
//
// Piano voicings store only pianoKeys (the notes to highlight).
// String instrument voicings store frets, fingers, barres, baseFret.
model ChordVoicing {
  id         String         @id @default(cuid())
  instrument InstrumentType

  // The chord this voicing represents
  root   String // "C", "D", "F#", "Bb"
  suffix String // "major", "minor", "sus2", "maj7", "7", "add9", "dim"

  // Tuning — null means the default/standard tuning for the instrument
  tuningPresetId String?
  tuningPreset   TuningPreset? @relation(fields: [tuningPresetId], references: [id])

  // Selection / quality
  sortOrder Int     @default(0) // lower = preferred
  isDefault Boolean @default(false) // the recommended first voicing
  label     String? // "Open", "Barre 5th", "Jazz voicing", "Capo shape"

  // Source tracking
  source String @default("chords-db") // "chords-db" | "generated" | "manual"

  // Fretboard data (guitar / bass / ukulele)
  // frets: per-string fret number. -1 = muted, 0 = open, 1+ = fret number
  frets    Int[] // length = string count for instrument
  fingers  Int[] // per-string finger number (1=index…4=pinky, 0=none)
  barres   Int[] // fret numbers where a full barre is applied
  baseFret Int     @default(1) // which fret the diagram starts at
  isCapo   Boolean @default(false)

  // Piano data (only populated when instrument = PIANO)
  pianoKeys String[] // note names to highlight: ["C", "E", "G"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instrument, root, suffix])
  @@index([instrument, root, suffix, tuningPresetId])
  @@index([instrument, isDefault])
  @@index([source])
}

// ============================================================
// IMPORT JOBS
// ============================================================

// Tracks URL-based scrape and import jobs initiated by users.
// Scraping runs in the BullMQ worker, not the API process.
model ImportJob {
  id             String       @id @default(cuid())
  userId         String
  sourceUrl      String? // URL scraped, if URL-based
  sourceFormat   ImportFormat
  state          String       @default("pending") // pending | processing | needs_review | complete | failed
  errorMessage   String? // Set on failure — instructs user to try clipboard paste
  rawContent     String? // Extracted raw text from scraper (before format parsing)
  draftVersionId String? // SongVersion created as draft, awaiting user review
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftVersion SongVersion? @relation(fields: [draftVersionId], references: [id])

  @@index([userId])
  @@index([state])
}

// ============================================================
// DRUM GROOVE ENGINE
// ============================================================

// GrooveCategory — top-level style category (Rock, Jazz, Latin, etc.)
model GrooveCategory {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "rock", "jazz", "latin"
  label     String // e.g. "Rock", "Jazz", "Latin"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  styles GrooveStyle[]
}

// GrooveStyle — a named style within a category, with multiple variants
// e.g. category=rock, style=arena_rock, variants=[simple, medium, full]
model GrooveStyle {
  id            String   @id @default(cuid())
  categoryId    String
  slug          String   @unique // e.g. "rock_arena", "jazz_swing", "latin_bossa"
  label         String // e.g. "Arena Rock", "Jazz Swing", "Bossa Nova"
  description   String?
  timeSignature String   @default("4/4") // "4/4", "3/4", "6/8" etc.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  category        GrooveCategory      @relation(fields: [categoryId], references: [id])
  patterns        GroovePattern[]
  arrangementUses ArrangementGroove[]

  @@index([categoryId])
}

// GroovePattern — a single playable pattern for a style variant
// patternJson stores a 16th-note grid (or 8th for 3/4 etc.) with velocity per
// drum instrument: kick, snare, hihat_closed, hihat_open, ride, crash, tom_hi, tom_lo
// Example: { "steps": 16, "instruments": { "kick": [{"step":0,"vel":100}, ...], ... } }
model GroovePattern {
  id          String   @id @default(cuid())
  styleId     String
  variant     String // "simple" | "medium" | "full" | "half_time" | "double_time"
  label       String // e.g. "Full", "Simple", "Half-time"
  patternJson Json // 16th-note grid pattern definition
  createdAt   DateTime @default(now())

  style GrooveStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, variant])
  @@index([styleId])
}

// ArrangementGroove — per-arrangement-item groove override
// If set, overrides the section-level groove from the SongDocument
model ArrangementGroove {
  id                String   @id @default(cuid())
  arrangementId     String
  arrangementItemId String // References ai_ ID in ArrangementDocument
  grooveStyleId     String
  variant           String
  tempoRelative     Float    @default(1.0) // 0.5 = half-time, 2.0 = double-time
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  arrangement Arrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  grooveStyle GrooveStyle @relation(fields: [grooveStyleId], references: [id])

  @@unique([arrangementId, arrangementItemId])
  @@index([arrangementId])
}

// ============================================================
// USER ARRANGEMENT MIDI CONFIG
// ============================================================

// Per-user, per-arrangement MIDI trigger configuration.
// Deliberately NOT stored in ArrangementDocument so arrangements
// stay portable and shareable across users with different MIDI setups.

model UserArrangementMidi {
  id            String   @id @default(cuid())
  userId        String
  arrangementId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enabled Boolean @default(true)

  // JSON array of MidiItemTrigger:
  // [{ arrangementItemId, events: [{ type, channel, program?, cc?, value? }] }]
  itemTriggersJson Json

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  arrangement Arrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)

  @@unique([userId, arrangementId])
  @@index([userId])
  @@index([arrangementId])
}

// ============================================================
// AUDIT EVENTS
// ============================================================

model AuditEvent {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String // "SongVersion" | "Arrangement" | "Team" | etc.
  entityId    String
  actorUserId String?
  createdAt   DateTime    @default(now())

  // Snapshot of relevant data at time of event
  metadata Json?

  // Target version (for song-related events)
  songVersionId String?

  actor       User?        @relation(fields: [actorUserId], references: [id])
  songVersion SongVersion? @relation(fields: [songVersionId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([songVersionId])
  @@index([createdAt])
}

// ============================================================
// STORAGE SETTINGS
// ============================================================

// Singleton row (id is always the literal string "singleton") holding
// admin-managed R2/S3 object storage credentials, as an alternative to
// setting the R2_* env vars - see apps/api/src/storage/storage.service.ts.
// When this row is absent (or a field is null), StorageService falls back
// to the matching R2_* env var, then to local disk. r2SecretAccessKeyEnc
// is never stored or returned in plaintext - see secret-crypto.ts.
model StorageSettings {
  id                        String   @id @default("singleton")
  r2AccountId               String?
  r2AccessKeyId             String?
  r2SecretAccessKeyEnc      String?
  r2Bucket                  String?
  r2Endpoint                String?
  // Storage limit for a user, and for a team's pool, that no role sets
  // (issue #160). Null means the built-in default (see storage-quota.service.ts).
  defaultUserStorageLimitMb Int?
  defaultTeamStorageLimitMb Int?
  // The largest song file of each type, in MB ({ "PDF": 10, "AUDIO": 200 }),
  // over the built-in ones (issue #163).
  fileSizeLimitsMb          Json?
  updatedAt                 DateTime @updatedAt
}

// How the API protects itself (issue #113), edited in Admin > Security: its
// rate limits and who may read its docs. A null field falls back to its env
// var, then to the default (apps/api/src/security/security-settings.ts).
model SecuritySettings {
  id                          String   @id @default("singleton")
  rateLimitEnabled            Boolean?
  // Requests a minute: per signed-in user; per address before sign-in; on the expensive routes.
  rateLimitPerMinute          Int?
  rateLimitAnonymousPerMinute Int?
  rateLimitHeavyPerMinute     Int?
  // Proxies in front of the API whose X-Forwarded-For is trusted for a client's address.
  trustedProxies              Int?
  // /api/docs for everyone, rather than global admins only.
  apiDocsPublic               Boolean?
  // The web app's Content-Security-Policy (issue #114): ENFORCE, REPORT_ONLY or OFF.
  contentSecurityPolicy       String?
  // Only invited people can create an account (issue #198).
  signupInviteOnly            Boolean?
  updatedAt                   DateTime @updatedAt
}

// How notifications go out besides the bell (issue #236), set in Admin >
// Notifications: each field null takes its env var, then the default.
model NotificationSettings {
  id                       String   @id @default("singleton")
  // Notifications sent by email at all (NOTIFICATION_EMAILS; off by default).
  emailEnabled             Boolean?
  // Web push's VAPID key pair (VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY), the private key
  // encrypted with SETTINGS_ENCRYPTION_KEY; and who sends (VAPID_SUBJECT).
  vapidPublicKey           String?
  vapidPrivateKeyEncrypted String?
  vapidSubject             String?
  updatedAt                DateTime @updatedAt
}

// A device someone turned notifications on for (issue #236): its browser's
// push subscription. Gone when the push service says it's expired.
model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  // The push service's address for the device: Google's, Mozilla's, Apple's, Microsoft's.
  endpoint     String    @unique
  p256dh       String
  auth         String
  // Which device, as its browser named it: "Chrome on Android".
  label        String?
  // Which web app turned it on (issue #241): "planiverse", or null for Songverse.
  app          String?
  createdAt    DateTime  @default(now())
  lastPushedAt DateTime?
  // Why the last push to it failed (issue #237): the push service's answer, or that it couldn't be reached; cleared by a push that works.
  lastError    String?
  lastErrorAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Content of a deleted user, held for a limited time behind a one-time
// link. Whoever opens the link while signed in (before expiresAt) becomes
// the owner of everything the deleted user personally owned; unclaimed
// content is deleted with the user once it expires. Only a hash of the
// link's token is stored.
model ContentTransfer {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  fromUserId      String   @unique
  // Snapshot of who the content came from, since the user row itself has
  // been anonymized by the time anyone looks at this.
  fromDisplayName String
  fromEmail       String
  createdByUserId String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  fromUser User @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Singleton row (id is always the literal string "singleton") holding
// admin-managed Resend and Google OAuth credentials, as an alternative to
// the RESEND_API_KEY/EMAIL_FROM/GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET env
// vars - see apps/web/src/lib/auth-settings.ts. When this row is absent
// (or a field is null), auth-settings.ts falls back to the matching env
// var. resendApiKeyEnc/googleClientSecretEnc are never stored or returned
// in plaintext - see packages/core/src/secret-crypto.
// Splitting recordings into stems (issue #63): our Demucs API's address and
// key (encrypted with SETTINGS_ENCRYPTION_KEY), the secret its webhooks are
// signed with (generated, encrypted), the models, whether the HQ pass runs,
// and an optional monthly limit per user. A null field falls back to its env
// var, then the default (apps/api/src/stem-separation/stem-separation-settings.ts).
model StemSeparationSettings {
  id                String   @id @default("singleton")
  apiUrl            String?
  apiKeyEnc         String?
  callbackSecretEnc String?
  fastModel         String?
  hqModel           String?
  hqEnabled         Boolean?
  monthlyLimit      Int?
  // Teams and organisations may connect their own Sonic servers (issue #300),
  // and those may be on private or local addresses; null: the env var, else no.
  ownServers        Boolean?
  ownServersPrivate Boolean?
  updatedAt         DateTime @updatedAt
}

// A Songverse Sonic server a team or an organisation runs and connected
// (issue #300): its team's songs - an organisation's, its teams' songs -
// are split there rather than on the instance's. Its key and the secret
// its webhooks are signed with are encrypted at rest.
model SonicServer {
  id                String   @id @default(cuid())
  teamId            String?  @unique
  organizationId    String?  @unique
  apiUrl            String
  apiKeyEnc         String
  callbackSecretEnc String
  fastModel         String?
  hqModel           String?
  hqEnabled         Boolean  @default(true)
  // Separations each member may start in 30 days; null: no limit.
  monthlyLimit      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team         Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  separations  StemSeparation[]
}

enum StemSeparationStatus {
  QUEUED // waiting for the Worker to send it
  SUBMITTED // at the Demucs API, its fast pass to come
  FAST_READY // the fast stems in; the HQ pass to come
  COMPLETED
  FAILED
}

// A recording split into stems (issue #63): the job at the Demucs API, and
// the multitrack its stems became - the fast pass's, replaced in place by
// the HQ pass's.
model StemSeparation {
  id                   String               @id @default(cuid())
  songVersionId        String
  // The recording it came from (no foreign key: the stems stay if it goes).
  sourceAttachmentId   String
  requestedByUserId    String?
  // "4" (htdemucs), "6" (htdemucs_6s) or "2" (vocals and the rest).
  parts                String
  status               StemSeparationStatus @default(QUEUED)
  // Its job at the server it went to: unique on that server only.
  jobId                String?
  // A team's or an organisation's own server (issue #300), else the instance's;
  // `ownServer` stays when that server's removed, so it isn't asked of the instance's.
  sonicServerId        String?
  ownServer            Boolean              @default(false)
  multitrackId         String?
  hqRequested          Boolean              @default(false)
  hqDone               Boolean              @default(false)
  // The models it was sent with (issue #175): Admin's at the time, which can
  // change later. No finer pass, no hqModel.
  fastModel            String?
  hqModel              String?
  // The recording's name, kept for the list after it's deleted.
  sourceFilename       String?
  // The earlier separation's multitrack its stems replace (issue #175), once in.
  replacesMultitrackId String?
  error                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  songVersion SongVersion  @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  requestedBy User?        @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  sonicServer SonicServer? @relation(fields: [sonicServerId], references: [id], onDelete: SetNull)

  @@index([songVersionId])
  @@index([requestedByUserId, createdAt])
  @@index([jobId])
  @@index([sonicServerId])
}

// Live collaboration (issue #27): typing in the same song together in the
// editor. Off by default while it's new; Admin > Collaboration turns it on.
model CollaborationSettings {
  id            String   @id @default("singleton")
  liveCoEditing Boolean?
  updatedAt     DateTime @updatedAt
}

model AuthSettings {
  id                    String   @id @default("singleton")
  resendApiKeyEnc       String?
  emailFrom             String?
  googleClientId        String?
  googleClientSecretEnc String?
  updatedAt             DateTime @updatedAt
}

// Song artwork (issue #85): taken from Apple Music (the iTunes Search
// API, no key needed) - on or off, and the storefront (country) searched.
// No row: on, in the "us" storefront.
model ArtworkSettings {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(true)
  country   String?
  updatedAt DateTime @updatedAt
}

// Which metadata providers Auto detect asks, and in what order (issue #22):
// `providers` is the ordered list [{ key, enabled }]. None: the
// METADATA_PROVIDERS env var, then every provider in the default order.
// The Apple Music API's MusicKit keys (issue #87): with all three, Apple
// Music is asked through the API; the private key (.p8) encrypted with
// SETTINGS_ENCRYPTION_KEY. None: the APPLE_MUSIC_* env vars, then the
// iTunes Search API, which needs no key.
model MetadataSettings {
  id                      String   @id @default("singleton")
  providers               Json?
  appleMusicTeamId        String?
  appleMusicKeyId         String?
  appleMusicPrivateKeyEnc String?
  // A stopgap without a key: an address handing out developer tokens
  // (`{ "token": "eyJ…" }`), used until a key is set. APPLE_MUSIC_TOKEN_URL.
  appleMusicTokenUrl      String?
  // Artist pictures and bios (issue #86): looked up or not. None: on.
  artistsEnabled          Boolean?
  // The contact MusicBrainz is told in the User-Agent (issue #89). None:
  // MUSICBRAINZ_CONTACT, then Songverse's site.
  musicbrainzContact      String?
  // Spotify's Web API (issue #89): a developer app's client ID and secret
  // (encrypted), and the market (country) searched. None: SPOTIFY_CLIENT_ID
  // / SPOTIFY_CLIENT_SECRET / SPOTIFY_MARKET; without a client, Spotify
  // isn't asked.
  spotifyClientId         String?
  spotifyClientSecretEnc  String?
  spotifyMarket           String?
  // The YouTube Data API's key (issue #169, encrypted), for the song links'
  // YouTube search. None: YOUTUBE_API_KEY; without one, no YouTube search.
  youtubeApiKeyEnc        String?
  updatedAt               DateTime @updatedAt
}

// Bibles' settings (issue #304): YouVersion's Platform API's App Key,
// encrypted with SETTINGS_ENCRYPTION_KEY. None: YOUVERSION_APP_KEY; without
// one, YouVersion isn't asked and nothing about it shows.
model ScriptureSettings {
  id                  String   @id @default("singleton")
  youversionAppKeyEnc String?
  updatedAt           DateTime @updatedAt
}

// An artist (issue #86): the name songs credit (VersionContributor.source,
// as PERFORMER), matched by `key` - the name folded (no case or accents) -
// with a picture and a short bio. Not anyone's: the same for everyone who
// can see a song by them. The picture is kept on our storage like song
// images (content-addressed, shared); `imageSource` says where it came
// from ("deezer", "upload"; "none" when nothing was found).
model Artist {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String
  imageStorageKey String?
  imageSource     String?
  // The source's own page for it (Deezer's), to credit it.
  imageSourceUrl  String?
  musicbrainzId   String?
  wikidataId      String?
  // When the providers were last asked; null: never.
  lookedUpAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bios ArtistBio[]
}

// An artist's short bio in one language (issue #86): Wikipedia's summary
// (with the article, to credit it), or one written here (`custom`), which a
// new lookup leaves alone.
model ArtistBio {
  id        String   @id @default(cuid())
  artistId  String
  language  String // "en", "fr"
  text      String
  sourceUrl String?
  custom    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, language])
}

// A user's saved library filter (issue #58): a songs list kept under a
// name - its search, filters and sort, not the songs themselves, so it's
// always current. `filters` is { q?, language?, tagId?, artist?, sort?, dir? }.
model SmartList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// SONG HISTORY (issue #71)
// ============================================================

enum SongRevisionKind {
  CREATED
  EDITED
  RESTORED
  // The song as it was before its history was kept: recorded on its first
  // save after this shipped, so that save can be undone too.
  BASELINE
}

/// A song version as it was after one save: the chart, its details and
/// credits (see SongSnapshot in @oneverse/core). Tags, files, links and
/// arrangements aren't in it - they have owners and lives of their own.
/// Saves by the same person a few minutes apart update one entry
/// (`updatedAt` moves on), so a working session is one step. Restoring an
/// entry saves its state again, as a new RESTORED entry.
model SongVersionRevision {
  id             String           @id @default(cuid())
  songVersionId  String
  kind           SongRevisionKind
  // Who saved it; null once they're deleted, or for BASELINE entries.
  authorUserId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // What changed since the entry before: "chart", "details", "credits".
  changes        String[]
  // song-snapshot/v1
  snapshot       Json
  // RESTORED: the entry it brought back.
  restoredFromId String?

  songVersion  SongVersion           @relation(fields: [songVersionId], references: [id], onDelete: Cascade)
  author       User?                 @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  restoredFrom SongVersionRevision?  @relation("RevisionRestoredFrom", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restoredAs   SongVersionRevision[] @relation("RevisionRestoredFrom")

  @@index([songVersionId, createdAt])
  @@index([authorUserId])
}

// ============================================================
// PEOPLE (issue #77)
// ============================================================

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Two people connected in Songverse, so they can share songs with each
/// other (People). Asked for by email: `addresseeEmail` is what the
/// requester typed (lower case), matched to an account when its owner
/// answers - so asking never tells whether an address has an account.
model Connection {
  id             String           @id @default(cuid())
  requesterId    String
  addresseeEmail String
  // Set when it's answered.
  addresseeId    String?
  status         ConnectionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  respondedAt    DateTime?

  requester User  @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User? @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeEmail])
  @@index([addresseeEmail])
  @@index([addresseeId])
}

/// A song a user starred (issue #81): their Favorites, on the Library's
/// home and as a filter. Private to them.
model FavoriteSong {
  userId        String
  songVersionId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)

  @@id([userId, songVersionId])
  @@index([songVersionId])
}

/// A user's last look at a song (issue #81): their Recently viewed, and -
/// counted across a team's members - what's popular in the team. One row
/// per user and song; only its user sees their own.
model SongView {
  userId        String
  songVersionId String
  viewedAt      DateTime @default(now())
  /// Views, a view within the hour before not counting again.
  count         Int      @default(1)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  songVersion SongVersion @relation(fields: [songVersionId], references: [id], onDelete: Cascade)

  @@id([userId, songVersionId])
  @@index([userId, viewedAt])
  @@index([songVersionId, viewedAt])
}

// What someone may do beyond using their own and their teams' songs (issue
// #160): review submissions to the global catalogue, split recordings into
// stems, how much they may store - and, later, a plugin's permissions. Given
// to users and to teams (a team's roles apply to each member, and its storage
// limit to its pool); someone can do what any of their roles allows, and the
// largest limit wins. Global admins can do everything, whatever their roles.
model Role {
  id                         String   @id @default(cuid())
  name                       String   @unique
  description                String   @default("")
  // The ones that came with Songverse ("REVIEWER", "STEM_SEPARATION",
  // "AUDIO_UPLOADS"): kept, so they can be edited but not deleted.
  builtIn                    String?  @unique
  canReview                  Boolean  @default(false)
  canSeparateStems           Boolean  @default(false)
  // Lossless audio uploads (WAV, FLAC, AIFF) keep their original, as FLAC,
  // beside the Opus copy that's played (issue #182); without it, only the
  // Opus copy is kept.
  canKeepLosslessAudio       Boolean  @default(false)
  // Uploading audio files (issue #183). Without it, someone can still record
  // in Songverse (a take it processes) and have stems separated.
  canUploadAudio             Boolean  @default(false)
  // Runs a set's screens (issue #305): controls what's presented on the sets
  // its holders can open, beside the set's leader, and may lock the control.
  canOperateScreens          Boolean  @default(false)
  // Separations a month for who has this role; null uses Admin > Stem separation's.
  stemSeparationMonthlyLimit Int?
  // A storage tier: the limit it gives a user, or a team's pool.
  storageLimitMb             Int?
  // Granted by plugins later (issue #157).
  permissions                String[] @default([])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  assignments RoleAssignment[]
}

// A role given to a user or to a team (exactly one of the two).
model RoleAssignment {
  id        String   @id @default(cuid())
  roleId    String
  userId    String?
  teamId    String?
  createdAt DateTime @default(now())

  role Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId])
  @@unique([roleId, teamId])
  @@index([userId])
  @@index([teamId])
}

// An instrument an admin added to the built-in list (INSTRUMENTS in
// packages/core, issue #166). Someone picks it by its id, kept in
// User.instruments with the built-in keys; removing it takes it off them.
model CustomInstrument {
  id           String   @id @default(cuid())
  label        String // in English, and the fallback
  translations Json? // per locale, e.g. {"fr": "Contrebasse"}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A big screen showing a set (issue #186): a TV's browser, a laptop on
// HDMI, the Google TV app (#187). Paired by a code someone who leads the set
// confirms; then it signs in with its own token - kept only as a hash here -
// which reads the set it's given and nothing else. Deleting it disconnects
// the screen.
model Screen {
  id                  String        @id @default(cuid())
  name                String
  mode                ScreenMode    @default(LYRICS)
  tokenHash           String        @unique
  // Whose it is (issue #222): a person's, a team's or an organisation's -
  // exactly one. Its managers rename it, change its look or disconnect it.
  ownerUserId         String?
  ownerTeamId         String?
  ownerOrganizationId String?
  setlistId           String?
  // A set put on it (FIXED), or its owner's set of the day (DAY, issue
  // #274): then setlistId is the one it shows now, worked out each time it
  // loads; picked on the screen itself, it stays for that day (setlistPickedOn).
  setMode             ScreenSetMode @default(FIXED)
  setlistPickedOn     String?
  // Who put its set on it: it reads the set as they would.
  setByUserId         String?
  // Its look (issue #194): a saved theme, or a built-in one by its id ("concert"); neither, the default.
  themeId             String?
  themeTemplate       String?
  // The layers it never shows (issue #287), whatever the operator does: a
  // stage monitor without the background, a lobby TV without the words.
  hiddenLayers        String[]      @default([])
  // Effects (issue #281) shown, or off on a screen that can't keep up.
  effects             Boolean       @default(true)
  lastSeenAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  owner             User?         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerTeam         Team?         @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)
  ownerOrganization Organization? @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  setBy             User?         @relation("ScreenSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)
  setlist           Setlist?      @relation(fields: [setlistId], references: [id], onDelete: SetNull)
  theme             ScreenTheme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([ownerTeamId])
  @@index([ownerOrganizationId])
  @@index([setlistId])
  @@index([themeId])
}

// A look for screens (issue #194): a screen-theme/v1 document
// (docs/screen-theme-v1.md), a person's own or shared with a team - a
// venue or church matching its brand - picked per screen.
model ScreenTheme {
  id                String   @id @default(cuid())
  name              String
  // A template (issue #281): a screen-template/v1 document - its tags, its
  // widget grid and masks - and its parts beside it, each a saved part or a
  // built-in one by its id (a saved one deleted: the built-in classic). One
  // made before parts holds a whole screen-theme/v1 document and no parts;
  // it's split into parts the first time it's listed for editing.
  document          Json
  // A person's own, or a team's (its admins change it, its members pick it).
  ownerUserId       String?
  ownerTeamId       String?
  contentPartId     String?
  contentBuiltIn    String?
  backgroundPartId  String?
  backgroundBuiltIn String?
  effectsPartId     String?
  effectsBuiltIn    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner          User?              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  team           Team?              @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)
  contentPart    ScreenPart?        @relation("TemplateContent", fields: [contentPartId], references: [id], onDelete: SetNull)
  backgroundPart ScreenPart?        @relation("TemplateBackground", fields: [backgroundPartId], references: [id], onDelete: SetNull)
  effectsPart    ScreenPart?        @relation("TemplateEffects", fields: [effectsPartId], references: [id], onDelete: SetNull)
  screens        Screen[]
  assets         ScreenThemeAsset[]

  @@index([ownerUserId])
  @@index([ownerTeamId])
  @@index([contentPartId])
  @@index([backgroundPartId])
  @@index([effectsPartId])
}

// A template's part (issue #281), saved and edited on its own: a content
// theme (screen-content/v1), a background theme (screen-background/v1) or
// effects (screen-effects/v1). A person's own or a team's, as templates are;
// a content theme's fonts and a background theme's pictures and videos are
// its files.
model ScreenPart {
  id          String   @id @default(cuid())
  kind        String
  name        String
  document    Json
  ownerUserId String?
  ownerTeamId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner               User?              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  team                Team?              @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)
  assets              ScreenThemeAsset[]
  contentTemplates    ScreenTheme[]      @relation("TemplateContent")
  backgroundTemplates ScreenTheme[]      @relation("TemplateBackground")
  effectsTemplates    ScreenTheme[]      @relation("TemplateEffects")

  @@index([ownerUserId])
  @@index([ownerTeamId])
}

// A widget's default look (issue #273): its options and style (a
// ScreenWidgetLook), applied when it's added to a template - a person's own,
// or a team's, set by its admins.
model ScreenWidgetDefault {
  id          String   @id @default(cuid())
  kind        String
  look        Json
  ownerUserId String?
  ownerTeamId String?
  updatedAt   DateTime @updatedAt

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, kind])
  @@unique([ownerTeamId, kind])
}

// A theme's own file (issue #194): a background picture or looping video
// ("media"), or a font. Content-addressed in storage like every upload;
// the theme's document refers to it by id.
model ScreenThemeAsset {
  id         String   @id @default(cuid())
  // A part's (issue #281), or a template's made before parts.
  themeId    String?
  partId     String?
  kind       String
  storageKey String
  mimeType   String
  filename   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  theme ScreenTheme? @relation(fields: [themeId], references: [id], onDelete: Cascade)
  part  ScreenPart?  @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([themeId])
  @@index([partId])
  @@index([storageKey])
}

enum ScreenSetMode {
  FIXED
  DAY
}

enum ScreenMode {
  LYRICS
  CHART
}

// Someone invited to create an account (issue #198), for when sign-up is
// by invitation only: an account with this email can then be made. The
// token only opens the invitation's page (the email filled in).
model SignupInvitation {
  id          String    @id @default(cuid())
  email       String    @unique
  token       String    @unique
  invitedById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([invitedById])
}

// After a song of a set (issue #199): see SET_TRANSITIONS in packages/core.
/// What a set's item is (issue #305): what the screens cut into slides, each its own way.
enum SetlistItemKind {
  SONG
  TEXT
}

enum SetTransition {
  STOP
  NEXT
  SEGUE
  TRANSITION
}

// A brand (issue #279): an organisation's or a team's logos, colours, fonts,
// backgrounds and links, for templates and widgets to use. Its admins change
// it; its members, and an organisation's teams, use it. The colours, fonts
// and links are kept as sent (checked by core's brand schemas) and read
// through readBrand.
model Brand {
  id                  String   @id @default(cuid())
  name                String
  ownerTeamId         String?
  ownerOrganizationId String?
  // The one picked first among its owner's.
  isDefault           Boolean  @default(false)
  colors              Json     @default("[]")
  fonts               Json     @default("{}")
  website             String?
  socials             Json     @default("[]")
  whatsapp            Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  team         Team?         @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [ownerOrganizationId], references: [id], onDelete: Cascade)
  assets       BrandAsset[]

  @@index([ownerTeamId])
  @@index([ownerOrganizationId])
}

// A brand's file (issue #279): a logo in one of its slots (one each), a
// background (several), or a font. Content-addressed in storage, like the
// screen themes' files.
model BrandAsset {
  id         String   @id @default(cuid())
  brandId    String
  kind       String
  // A background's or a font's name; a font's family name in templates.
  name       String?
  storageKey String
  mimeType   String
  filename   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([storageKey])
}

                  1,
                  3
                ]
              }
            },
            {
              "beats": 1
            }
          ],
          "expected": {
            "firstBeat": 1.5,
            "map": {
              "beats": [
                1.5,
                2,
                2.5,
                3,
                3.5,
                4,
                4.5
              ],
              "downbeats": [
                1.5,
                3.5
              ]
            }
          }
        },
        {
          "name": "the 1 a beat earlier",
          "args": [
            {
              "tempo": 120,
              "firstBeat": 1,
              "map": {
                "beats": [
                  1,
                  1.5,
                  2,
                  2.5,
                  3,
                  3.5,
                  4,
                  4.5
                ],
                "downbeats": [
                  1,
                  3
                ]
              }
            },
            {
              "beats": -1
            }
          ],
          "expected": {
            "firstBeat": 0.5,
            "map": {
              "beats": [
                0.5,
                1,
                1.5,
                2,
                2.5,
                3,
                3.5,
                4,
                4.5
              ],
              "downbeats": [
                0.5,
                2.5
              ]
            }
          }
        },
        {
          "name": "no map",
          "args": [
            {
              "tempo": 90,
              "firstBeat": 0.4,
              "map": null
            },
            {
              "beats": 1,
              "seconds": -0.01
            }
          ],
          "expected": {
            "firstBeat": 1.057,
            "map": null
          }
        }
      ]
    }
  }
}

{
  "$schema": "songverse-conformance/v1",
  "area": "requests",
  "about": "What the API takes (issue #118), checked as it checks them (checkRequest): the body it goes on with (defaults filled in, text trimmed), or the messages it answers 400 with. A client can check a form the same way before sending it.",
  "functions": {
    "CreateSongVersionSchema": {
      "about": "POST /song-versions",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "a title and language",
          "args": [
            {
              "title": "  Amazing Grace ",
              "language": "en",
              "artists": [
                "John Newton"
              ]
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "title": "Amazing Grace",
              "artists": [
                "John Newton"
              ],
              "language": "en"
            }
          }
        },
        {
          "name": "no title",
          "args": [
            {
              "language": "en",
              "artists": [
                "X"
              ]
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "title must be a string"
            ]
          }
        },
        {
          "name": "fields it doesn't know",
          "args": [
            {
              "title": "X",
              "language": "en",
              "artists": [
                "X"
              ],
              "colour": "red",
              "mood": "happy"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "property colour should not exist",
              "property mood should not exist"
            ]
          }
        },
        {
          "name": "a year too early",
          "args": [
            {
              "title": "X",
              "language": "en",
              "artists": [
                "X"
              ],
              "year": 999
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "year must not be less than 1000"
            ]
          }
        },
        {
          "name": "no artist",
          "args": [
            {
              "title": "X",
              "language": "en",
              "artists": []
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "A song needs at least one artist"
            ]
          }
        }
      ]
    },
    "UpdateSongVersionSchema": {
      "about": "PATCH /song-versions/:id: null or \"\" clears a field.",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "clearing the album",
          "args": [
            {
              "album": ""
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "album": null
            }
          }
        },
        {
          "name": "a capo out of range",
          "args": [
            {
              "capo": 14
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "capo must not be greater than 11"
            ]
          }
        }
      ]
    },
    "CreateTeamEventSchema": {
      "about": "POST /teams/:teamId/events (issue #235)",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "every Sunday morning",
          "args": [
            {
              "title": "Morning service",
              "date": "2026-10-11",
              "startTime": "10:00",
              "timeZone": "Europe/Paris",
              "repeat": {
                "everyWeeks": 1
              }
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "title": "Morning service",
              "date": "2026-10-11",
              "startTime": "10:00",
              "timeZone": "Europe/Paris",
              "repeat": {
                "everyWeeks": 1
              }
            }
          }
        },
        {
          "name": "a time and a zone that aren't",
          "args": [
            {
              "title": "Rehearsal",
              "date": "2026-02-30",
              "startTime": "25:00",
              "timeZone": "Mars/Olympus"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "date must be a date, YYYY-MM-DD",
              "startTime must be a time, HH:MM",
              "timeZone must be a time zone, like Europe/Paris"
            ]
          }
        }
      ]
    },
    "AnswerEventDateSchema": {
      "about": "PUT /teams/:teamId/events/:eventId/dates/:date/answer (issue #235)",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "available, with a note",
          "args": [
            {
              "answer": "AVAILABLE",
              "note": "Keys only"
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "answer": "AVAILABLE",
              "note": "Keys only"
            }
          }
        },
        {
          "name": "an answer that isn't one",
          "args": [
            {
              "answer": "MAYBE"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "answer must be one of the following values: AVAILABLE, IF_NEEDED, UNAVAILABLE"
            ]
          }
        }
      ]
    },
    "CreateAwaySchema": {
      "about": "POST /users/me/away (issue #235)",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "two weeks in August",
          "args": [
            {
              "from": "2026-08-01",
              "to": "2026-08-15",
              "note": "Holidays"
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "from": "2026-08-01",
              "to": "2026-08-15",
              "note": "Holidays"
            }
          }
        },
        {
          "name": "ending before it starts",
          "args": [
            {
              "from": "2026-08-15",
              "to": "2026-08-01"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "to must not be before from"
            ]
          }
        }
      ]
    },
    "CreateSetlistSchema": {
      "about": "POST /setlists",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "a name",
          "args": [
            {
              "name": "Sunday"
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "name": "Sunday"
            }
          }
        },
        {
          "name": "no name: shown by its date",
          "args": [
            {
              "eventDate": "2026-10-04"
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "eventDate": "2026-10-04"
            }
          }
        },
        {
          "name": "a date that isn't one",
          "args": [
            {
              "name": "Sunday",
              "eventDate": "4/10/2026"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "eventDate must be YYYY-MM-DD"
            ]
          }
        }
      ]
    },
    "AddSetlistItemSchema": {
      "about": "POST /setlists/:id/items",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "a song",
          "args": [
            {
              "songVersionId": "song_1"
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "songVersionId": "song_1"
            }
          }
        },
        {
          "name": "nothing",
          "args": [
            {}
          ],
          "expected": {
            "ok": false,
            "messages": [
              "songVersionId must be a string"
            ]
          }
        }
      ]
    },
    "CreateNoteSchema": {
      "about": "POST /notes (issue #256): where it's saved needs its team, songbook or set, and nothing else",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "just me, on the whole song",
          "args": [
            {
              "songVersionId": "song_1",
              "content": " Capo 2 ",
              "place": "ME"
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "songVersionId": "song_1",
              "content": "Capo 2",
              "place": "ME",
              "anchor": {
                "kind": "song"
              }
            }
          }
        },
        {
          "name": "just me, only in a set, on a chord",
          "args": [
            {
              "songVersionId": "song_1",
              "content": "Let ring",
              "place": "ME",
              "setlistId": "set_1",
              "anchor": {
                "kind": "chord",
                "sectionId": "sec_verse",
                "lineId": "line_v1",
                "chordId": "chd_v2"
              }
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "songVersionId": "song_1",
              "content": "Let ring",
              "place": "ME",
              "setlistId": "set_1",
              "anchor": {
                "kind": "chord",
                "sectionId": "sec_verse",
                "lineId": "line_v1",
                "chordId": "chd_v2"
              }
            }
          }
        },
        {
          "name": "in a team, without the team",
          "args": [
            {
              "songVersionId": "song_1",
              "content": "Softer",
              "place": "TEAM"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "teamId is needed for a note saved in a team"
            ]
          }
        },
        {
          "name": "in a set, with a team too",
          "args": [
            {
              "songVersionId": "song_1",
              "content": "Softer",
              "place": "SET",
              "setlistId": "set_1",
              "teamId": "team_1"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "teamId doesn't go with a note saved in a set"
            ]
          }
        },
        {
          "name": "empty",
          "args": [
            {
              "songVersionId": "song_1",
              "content": "  ",
              "place": "SONG"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "content should not be empty"
            ]
          }
        },
        {
          "name": "an anchor that isn't one",
          "args": [
            {
              "songVersionId": "song_1",
              "content": "x",
              "place": "ME",
              "anchor": {
                "kind": "bar",
                "bar": 3
              }
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "anchor's kind must be one of song, section, afterPass, afterLine, line, chord, word"
            ]
          }
        }
      ]
    },
    "UpdateUserSchema": {
      "about": "PATCH /users/me",
      "params": [
        "body"
      ],
      "cases": [
        {
          "name": "a language and instruments",
          "args": [
            {
              "locale": "fr",
              "instruments": [
                "DRUMS",
                "HARP"
              ]
            }
          ],
          "expected": {
            "ok": true,
            "value": {
              "locale": "fr",
              "instruments": [
                "DRUMS",
                "HARP"
              ]
            }
          }
        },
        {
          "name": "a language that isn't offered",
          "args": [
            {
              "locale": "de"
            }
          ],
          "expected": {
            "ok": false,
            "messages": [
              "locale must be one of the following values: en, fr"
            ]
          }
        }
      ]
    }
  }
}

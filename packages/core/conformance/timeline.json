{
  "$schema": "songverse-conformance/v1",
  "area": "timeline",
  "about": "The metronome and sync play's timeline (issue #13): only \"beat N at server time T\" crosses the network, and each device plays it on its own clock. Positions are in beats from the start, count-in included; times in ms.",
  "functions": {
    "applyStageCommand": {
      "about": "The media operator's timer and message for a set's screens (issue #269): a new timer stopped at its start, reset, started or paused, a minute more or less, then the message. Null: a command that can't be read, refused.",
      "params": [
        "stage",
        "command",
        "now",
        "presenting"
      ],
      "cases": [
        {
          "name": "a new 5-minute countdown, started",
          "args": [
            null,
            {
              "timer": {
                "kind": "countdown",
                "duration": 300
              },
              "run": true
            },
            10000
          ],
          "expected": {
            "rev": 1,
            "timer": {
              "kind": "countdown",
              "duration": 300,
              "startedAt": 10000,
              "elapsed": 0
            },
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "paused: the time it ran is kept",
          "args": [
            {
              "rev": 1,
              "timer": {
                "kind": "countdown",
                "duration": 300,
                "startedAt": 10000,
                "elapsed": 0
              },
              "message": null
            },
            {
              "run": false
            },
            70000
          ],
          "expected": {
            "rev": 2,
            "timer": {
              "kind": "countdown",
              "duration": 300,
              "startedAt": null,
              "elapsed": 60000
            },
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "started again after a pause",
          "args": [
            {
              "rev": 2,
              "timer": {
                "kind": "countdown",
                "duration": 300,
                "startedAt": null,
                "elapsed": 60000
              },
              "message": null
            },
            {
              "run": true
            },
            100000
          ],
          "expected": {
            "rev": 3,
            "timer": {
              "kind": "countdown",
              "duration": 300,
              "startedAt": 100000,
              "elapsed": 60000
            },
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "a minute more on a countdown",
          "args": [
            {
              "rev": 2,
              "timer": {
                "kind": "countdown",
                "duration": 300,
                "startedAt": null,
                "elapsed": 60000
              },
              "message": null
            },
            {
              "add": 60
            },
            100000
          ],
          "expected": {
            "rev": 3,
            "timer": {
              "kind": "countdown",
              "duration": 360,
              "startedAt": null,
              "elapsed": 60000
            },
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "reset while running: from its start, now",
          "args": [
            {
              "rev": 3,
              "timer": {
                "kind": "count-up",
                "duration": 0,
                "startedAt": 10000,
                "elapsed": 5000
              },
              "message": null
            },
            {
              "reset": true
            },
            50000
          ],
          "expected": {
            "rev": 4,
            "timer": {
              "kind": "count-up",
              "duration": 0,
              "startedAt": 50000,
              "elapsed": 0
            },
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "a message, then cleared",
          "args": [
            {
              "rev": 1,
              "timer": null,
              "message": {
                "text": "Wrap up",
                "at": 1
              }
            },
            {
              "message": "  "
            },
            9000
          ],
          "expected": {
            "rev": 2,
            "timer": null,
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "a message sent, the timer kept",
          "args": [
            {
              "rev": 1,
              "timer": {
                "kind": "count-up",
                "duration": 0,
                "startedAt": 5,
                "elapsed": 0
              },
              "message": null
            },
            {
              "message": " Next: announcements "
            },
            9000
          ],
          "expected": {
            "rev": 2,
            "timer": {
              "kind": "count-up",
              "duration": 0,
              "startedAt": 5,
              "elapsed": 0
            },
            "message": {
              "text": "Next: announcements",
              "at": 9000
            },
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "a duration out of range: refused",
          "args": [
            null,
            {
              "timer": {
                "kind": "countdown",
                "duration": 100000
              }
            },
            0
          ],
          "expected": null
        },
        {
          "name": "a message too long: refused",
          "args": [
            null,
            {
              "message": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
            },
            0
          ],
          "expected": null
        },
        {
          "name": "the media hidden on every screen (issue #280), the rest kept",
          "args": [
            {
              "rev": 4,
              "timer": null,
              "message": null
            },
            {
              "layers": {
                "show": {
                  "media": false
                }
              }
            },
            1000
          ],
          "expected": {
            "rev": 5,
            "timer": null,
            "message": null,
            "layers": {
              "hidden": [
                "media"
              ],
              "title": false,
              "cleared": null
            }
          }
        },
        {
          "name": "the content cleared on the slide on screen",
          "args": [
            {
              "rev": 5,
              "timer": null,
              "message": null
            },
            {
              "layers": {
                "clear": [
                  "content"
                ]
              }
            },
            1000,
            {
              "itemId": "i1",
              "slide": 2
            }
          ],
          "expected": {
            "rev": 6,
            "timer": null,
            "message": null,
            "layers": {
              "hidden": [],
              "title": false,
              "cleared": {
                "itemId": "i1",
                "slide": 2,
                "layers": [
                  "content"
                ]
              }
            }
          }
        },
        {
          "name": "a layer that can't be read: refused",
          "args": [
            null,
            {
              "layers": {
                "show": {
                  "logo": false
                }
              }
            },
            0
          ],
          "expected": null
        }
      ]
    },
    "applyLayersCommand": {
      "about": "The operator's change to the screens' layers (issues #280, #287): for every screen, or one with `screen`; layers shown or hidden, the title card on or off, layers cleared until the slide on screen changes, or all back to normal (`reset`). A change for every screen applies to the ones with layers of their own too. Null: refused.",
      "params": [
        "layers",
        "command",
        "presenting"
      ],
      "cases": [
        {
          "name": "the video and the media hidden on every screen",
          "args": [
            null,
            {
              "show": {
                "video": false,
                "media": false
              }
            },
            null
          ],
          "expected": {
            "hidden": [
              "video",
              "media"
            ],
            "title": false,
            "cleared": null
          }
        },
        {
          "name": "the title card on, the media back",
          "args": [
            {
              "hidden": [
                "media"
              ],
              "title": false,
              "cleared": null
            },
            {
              "show": {
                "media": true
              },
              "title": true
            },
            null
          ],
          "expected": {
            "hidden": [],
            "title": true,
            "cleared": null
          }
        },
        {
          "name": "the content cleared on slide 2, then the overlays on the same slide",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": {
                "layers": [
                  "content"
                ],
                "itemId": "i1",
                "slide": 2
              }
            },
            {
              "clear": [
                "overlays"
              ]
            },
            {
              "itemId": "i1",
              "slide": 2
            }
          ],
          "expected": {
            "hidden": [],
            "title": false,
            "cleared": {
              "itemId": "i1",
              "slide": 2,
              "layers": [
                "content",
                "overlays"
              ]
            }
          }
        },
        {
          "name": "a clear from another slide is over when the next comes",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": {
                "layers": [
                  "content"
                ],
                "itemId": "i1",
                "slide": 1
              }
            },
            {
              "clear": [
                "media"
              ]
            },
            {
              "itemId": "i1",
              "slide": 2
            }
          ],
          "expected": {
            "hidden": [],
            "title": false,
            "cleared": {
              "itemId": "i1",
              "slide": 2,
              "layers": [
                "media"
              ]
            }
          }
        },
        {
          "name": "one screen: its own layers, from every screen's",
          "args": [
            {
              "hidden": [
                "video"
              ],
              "title": true,
              "cleared": null
            },
            {
              "screen": "s1",
              "show": {
                "media": false
              }
            },
            null
          ],
          "expected": {
            "hidden": [
              "video"
            ],
            "title": true,
            "cleared": null,
            "screens": {
              "s1": {
                "hidden": [
                  "video",
                  "media"
                ],
                "title": true,
                "cleared": null
              }
            }
          }
        },
        {
          "name": "every screen: the ones with their own too",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": null,
              "screens": {
                "s1": {
                  "hidden": [
                    "media"
                  ],
                  "title": false,
                  "cleared": null
                }
              }
            },
            {
              "show": {
                "content": false
              }
            },
            null
          ],
          "expected": {
            "hidden": [
              "content"
            ],
            "title": false,
            "cleared": null,
            "screens": {
              "s1": {
                "hidden": [
                  "media",
                  "content"
                ],
                "title": false,
                "cleared": null
              }
            }
          }
        },
        {
          "name": "one screen back to every screen's",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": null,
              "screens": {
                "s1": {
                  "hidden": [
                    "media"
                  ],
                  "title": false,
                  "cleared": null
                }
              }
            },
            {
              "screen": "s1",
              "reset": true
            },
            null
          ],
          "expected": {
            "hidden": [],
            "title": false,
            "cleared": null
          }
        },
        {
          "name": "all back to normal",
          "args": [
            {
              "hidden": [
                "media",
                "content"
              ],
              "title": true,
              "cleared": null,
              "screens": {
                "s1": {
                  "hidden": [
                    "media"
                  ],
                  "title": false,
                  "cleared": null
                }
              }
            },
            {
              "reset": true
            },
            null
          ],
          "expected": {
            "hidden": [],
            "title": false,
            "cleared": null
          }
        },
        {
          "name": "a layer that can't be read: refused",
          "args": [
            null,
            {
              "show": {
                "base": false
              }
            },
            null
          ],
          "expected": null
        },
        {
          "name": "a cleared layer that can't be read: refused",
          "args": [
            null,
            {
              "clear": [
                "words"
              ]
            },
            null
          ],
          "expected": null
        }
      ]
    },
    "readSyncLayers": {
      "about": "A stage's layers as a client reads them (issue #280): anything it can't read left out; the words, background and overlay kept before layers (issue #275) read as the content, the media and the title card.",
      "params": [
        "input"
      ],
      "cases": [
        {
          "name": "nothing: every layer, no title card",
          "args": [
            null
          ],
          "expected": {
            "hidden": [],
            "title": false,
            "cleared": null
          }
        },
        {
          "name": "before layers: the words hidden, the title card on",
          "args": [
            {
              "words": false,
              "background": true,
              "overlay": "title"
            }
          ],
          "expected": {
            "hidden": [
              "content"
            ],
            "title": true,
            "cleared": null
          }
        },
        {
          "name": "a layer from a later version: left out",
          "args": [
            {
              "hidden": [
                "media",
                "hologram"
              ],
              "title": false,
              "cleared": null
            }
          ],
          "expected": {
            "hidden": [
              "media"
            ],
            "title": false,
            "cleared": null
          }
        }
      ]
    },
    "screenLayers": {
      "about": "What a screen draws now (issue #287): its own layers if the operator gave it some, else every screen's; less what the screen itself never shows (its settings win), less what was cleared while the same slide is on.",
      "params": [
        "layers",
        "presenting",
        "screen"
      ],
      "cases": [
        {
          "name": "nothing set: every layer",
          "args": [
            null,
            null,
            null
          ],
          "expected": {
            "shown": {
              "video": true,
              "media": true,
              "content": true,
              "overlays": true,
              "masks": true
            },
            "title": false
          }
        },
        {
          "name": "cleared on this slide: hidden",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": {
                "layers": [
                  "content"
                ],
                "itemId": "i1",
                "slide": 2
              }
            },
            {
              "itemId": "i1",
              "slide": 2
            },
            null
          ],
          "expected": {
            "shown": {
              "video": true,
              "media": true,
              "content": false,
              "overlays": true,
              "masks": true
            },
            "title": false
          }
        },
        {
          "name": "cleared on the slide before: back",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": {
                "layers": [
                  "content"
                ],
                "itemId": "i1",
                "slide": 2
              }
            },
            {
              "itemId": "i1",
              "slide": 3
            },
            null
          ],
          "expected": {
            "shown": {
              "video": true,
              "media": true,
              "content": true,
              "overlays": true,
              "masks": true
            },
            "title": false
          }
        },
        {
          "name": "a screen with its own layers",
          "args": [
            {
              "hidden": [],
              "title": true,
              "cleared": null,
              "screens": {
                "s1": {
                  "hidden": [
                    "overlays"
                  ],
                  "title": false,
                  "cleared": null
                }
              }
            },
            null,
            {
              "id": "s1"
            }
          ],
          "expected": {
            "shown": {
              "video": true,
              "media": true,
              "content": true,
              "overlays": false,
              "masks": true
            },
            "title": false
          }
        },
        {
          "name": "a screen that never shows the media: not even when the operator shows it",
          "args": [
            {
              "hidden": [],
              "title": false,
              "cleared": null
            },
            null,
            {
              "id": "s2",
              "hidden": [
                "media"
              ]
            }
          ],
          "expected": {
            "shown": {
              "video": true,
              "media": false,
              "content": true,
              "overlays": true,
              "masks": true
            },
            "title": false
          }
        }
      ]
    },
    "clockOffset": {
      "about": "The server's clock less the device's, from the ping with the shortest round trip; null with none usable.",
      "params": [
        "samples"
      ],
      "cases": [
        {
          "name": "the quickest of three",
          "args": [
            [
              {
                "sent": 1000,
                "at": 5060,
                "received": 1100
              },
              {
                "sent": 2000,
                "at": 6015,
                "received": 2020
              },
              {
                "sent": 3000,
                "at": 7090,
                "received": 3200
              }
            ]
          ],
          "expected": {
            "offset": 4005,
            "rtt": 20
          }
        },
        {
          "name": "a sample from the future is left out",
          "args": [
            [
              {
                "sent": 1000,
                "at": 5000,
                "received": 900
              },
              {
                "sent": 2000,
                "at": 6010,
                "received": 2020
              }
            ]
          ],
          "expected": {
            "offset": 4000,
            "rtt": 20
          }
        },
        {
          "name": "none",
          "args": [
            []
          ],
          "expected": null
        }
      ]
    },
    "deviceTime": {
      "about": "A server time on this device's clock.",
      "params": [
        "serverTime",
        "offset"
      ],
      "cases": [
        {
          "name": "server ahead",
          "args": [
            10000,
            4000
          ],
          "expected": 6000
        },
        {
          "name": "server behind",
          "args": [
            10000,
            -250.5
          ],
          "expected": 10250.5
        }
      ]
    },
    "metronomePositionAt": {
      "about": "Where the leader's metronome is at a server time: on from its anchor at the tempo while playing.",
      "params": [
        "metronome",
        "serverTime"
      ],
      "cases": [
        {
          "name": "120 bpm, 1.5 s on",
          "args": [
            {
              "settings": {
                "tempo": 120
              },
              "playing": true,
              "anchorAt": 10000,
              "anchorPosition": 4
            },
            11500
          ],
          "expected": 7
        },
        {
          "name": "72 bpm, before its anchor",
          "args": [
            {
              "settings": {
                "tempo": 72
              },
              "playing": true,
              "anchorAt": 10000,
              "anchorPosition": 8
            },
            9000
          ],
          "expected": 6.8
        },
        {
          "name": "stopped",
          "args": [
            {
              "settings": {
                "tempo": 120
              },
              "playing": false,
              "anchorAt": 0,
              "anchorPosition": 6
            },
            99999
          ],
          "expected": 6
        }
      ]
    },
    "stemsPositionAt": {
      "about": "Seconds into the leader's recording at a server time: on from its anchor at its speed while playing, in the recording's own time.",
      "params": [
        "stems",
        "serverTime"
      ],
      "cases": [
        {
          "name": "at full speed",
          "args": [
            {
              "playing": true,
              "position": 30,
              "anchorAt": 10000
            },
            12500
          ],
          "expected": 32.5
        },
        {
          "name": "at 80%",
          "args": [
            {
              "playing": true,
              "position": 30,
              "anchorAt": 10000,
              "speed": 0.8
            },
            12500
          ],
          "expected": 32
        },
        {
          "name": "paused",
          "args": [
            {
              "playing": false,
              "position": 42.5,
              "anchorAt": 0
            },
            12500
          ],
          "expected": 42.5
        }
      ]
    },
    "normalizeMetronome": {
      "about": "Metronome settings made whole and within bounds: the tempo 20-300, a beat level per beat of the bar.",
      "params": [
        "input"
      ],
      "cases": [
        {
          "name": "nothing",
          "args": [
            null
          ],
          "expected": {
            "tempo": 100,
            "numerator": 4,
            "denominator": 4,
            "beats": [
              "accent",
              "normal",
              "normal",
              "normal"
            ],
            "subdivision": 1,
            "countIn": 0,
            "countInOnly": false,
            "sound": "click",
            "volume": 0.8
          }
        },
        {
          "name": "6/8",
          "args": [
            {
              "tempo": 90,
              "numerator": 6,
              "denominator": 8
            }
          ],
          "expected": {
            "tempo": 90,
            "numerator": 6,
            "denominator": 8,
            "beats": [
              "accent",
              "normal",
              "normal",
              "normal",
              "normal",
              "normal"
            ],
            "subdivision": 1,
            "countIn": 0,
            "countInOnly": false,
            "sound": "click",
            "volume": 0.8
          }
        },
        {
          "name": "too fast, beats missing",
          "args": [
            {
              "tempo": 999,
              "numerator": 3,
              "beats": [
                "accent"
              ]
            }
          ],
          "expected": {
            "tempo": 300,
            "numerator": 3,
            "denominator": 4,
            "beats": [
              "accent",
              "normal",
              "normal"
            ],
            "subdivision": 1,
            "countIn": 0,
            "countInOnly": false,
            "sound": "click",
            "volume": 0.8
          }
        }
      ]
    },
    "beatAt": {
      "about": "The bar (negative in the count-in), beat and fraction at a position.",
      "params": [
        "settings",
        "position"
      ],
      "cases": [
        {
          "name": "the start",
          "args": [
            {
              "numerator": 4,
              "countIn": 0
            },
            0
          ],
          "expected": {
            "bar": 0,
            "beat": 0,
            "fraction": 0
          }
        },
        {
          "name": "bar 2, beat 3 and a half",
          "args": [
            {
              "numerator": 4,
              "countIn": 0
            },
            6.5
          ],
          "expected": {
            "bar": 1,
            "beat": 2,
            "fraction": 0.5
          }
        },
        {
          "name": "in a bar of count-in",
          "args": [
            {
              "numerator": 4,
              "countIn": 1
            },
            2
          ],
          "expected": {
            "bar": -1,
            "beat": 2,
            "fraction": 0
          }
        },
        {
          "name": "after the count-in",
          "args": [
            {
              "numerator": 3,
              "countIn": 2
            },
            7
          ],
          "expected": {
            "bar": 0,
            "beat": 1,
            "fraction": 0
          }
        }
      ]
    },

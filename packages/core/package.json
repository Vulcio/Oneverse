{
  "name": "@oneverse/core",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/zod-config.js"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./i18n/locales/*": "./dist/i18n/locales/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "vp lint src --deny-warnings",
    "type-check": "tsc --noEmit",
    "test": "vp test",
    "conformance": "tsc -p tsconfig.json && node scripts/conformance.mjs",
    "song-provider-api": "tsc -p tsconfig.json && node scripts/song-provider-api.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@oneverse/tsconfig": "workspace:*",
    "typescript": "^5.7.3",
    "vite-plus": "1.0.0"
  }
}

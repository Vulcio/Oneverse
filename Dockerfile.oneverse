# Oneverse (issue #303): where people sign in to every app - Songverse,
# Planiverse - and manage their account (email, password, passkeys). Built
# and served like Songverse's web app (see Dockerfile.songverse for why it's
# a small Node server, and why this file sits at the repo root), by the web
# apps' shared server (packages/app/server/web-server.mjs).
#
# At runtime: API_URL (the API's address), SONGVERSE_URL and PLANIVERSE_URL
# (the apps' addresses: where a sign-in may go back to, and the account
# page's links). The API needs ONEVERSE_URL set to this app's address, and
# must share its parent domain (api.oneverse.top and oneverse.top).
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY patches ./patches
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/app/package.json packages/app/
COPY apps/oneverse/package.json apps/oneverse/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY packages/tsconfig packages/tsconfig
COPY packages/core packages/core
COPY packages/ui packages/ui
COPY packages/app packages/app
COPY apps/oneverse apps/oneverse
RUN pnpm --filter @oneverse/core build \
 && pnpm --filter @oneverse/oneverse build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /repo/node_modules /repo/node_modules
COPY --from=build /repo/packages /repo/packages
COPY --from=build /repo/apps/oneverse /repo/apps/oneverse
WORKDIR /repo/apps/oneverse
EXPOSE 3000
CMD ["node", "server.mjs"]
